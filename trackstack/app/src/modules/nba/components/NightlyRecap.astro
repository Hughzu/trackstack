---
import Card from '@/shared/components/UI/Card.astro';

// In Phase 2, this calls '@/modules/nba/services/api'
const games = [
  { 
    matchup: "LAL @ GSW", 
    reason: "Instant Classic", 
    color: "text-purple-400" 
  },
  { 
    matchup: "DEN @ NYK", 
    reason: "Game Winner", 
    color: "text-blue-400" 
  }
];
---

<Card variant="highlight" class="min-h-[140px]">
  <div class="flex justify-between items-start mb-3">
    <div class="flex items-center gap-2">
      <span class="text-xl">🏀</span>
      <h3 class="font-bold text-text-main">Nightly Recap</h3>
    </div>
    <span class="text-[10px] uppercase tracking-wider bg-surface/50 px-2 py-1 rounded text-text-muted">
      2 Must Watch
    </span>
  </div>

  <div class="space-y-3">
    {games.map(game => (
      <div class="flex justify-between items-center border-b border-white/5 pb-2 last:border-0 last:pb-0">
        <div class="flex flex-col">
          <span class="font-bold text-sm text-text-main">{game.matchup}</span>
          <span class={`text-xs ${game.color}`}>{game.reason}</span>
        </div>
      </div>
    ))}
  </div>
</Card>