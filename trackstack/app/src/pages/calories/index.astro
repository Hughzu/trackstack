---
import AppShell from '@/shared/layouts/AppShell.astro';
import Card from '@/shared/components/UI/Card.astro';
import Fab from '@/shared/components/UI/Fab.astro';

// MOCK DATA
const today = {
  consumed: 1850,
  target: 2500,
  protein: 145,
  targetProtein: 180
};

const macros = [
  { label: 'Carbs', amount: '220g', percent: 50, color: 'bg-orange-400' },
  { label: 'Fat', amount: '65g', percent: 30, color: 'bg-yellow-400' },
  { label: 'Protein', amount: '145g', percent: 20, color: 'bg-emerald-400' },
];

const logs = [
  { id: 1, title: 'Oatmeal & Whey', calories: 450, time: '08:30', protein: '35g' },
  { id: 2, title: 'Chicken Salad', calories: 650, time: '13:00', protein: '45g' },
  { id: 3, title: 'Greek Yogurt', calories: 200, time: '16:00', protein: '20g' },
  { id: 4, title: 'Pasta Bolognese', calories: 550, time: '19:30', protein: '45g' },
];

const percent = Math.min((today.consumed / today.target) * 100, 100);
---

<AppShell title="Health" currentDomain="calories">
  
  <div class="flex flex-col gap-5 pb-24">

    <!-- Summary Card -->
    <section>
      <Card class="bg-gradient-to-br from-surface to-[#23262d]">
        <div class="flex justify-between items-start mb-6">
          <div>
            <span class="text-xs text-text-muted uppercase tracking-widest">Daily Intake</span>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-bold text-text-main">{today.consumed}</span>
              <span class="text-sm font-mono text-text-muted">/ {today.target} kcal</span>
            </div>
          </div>
          <div class="text-right">
             <span class="text-xs text-text-muted uppercase tracking-widest">Protein</span>
             <div class="text-sm font-bold text-emerald-400">{today.protein}g <span class="text-text-muted font-normal">/ {today.targetProtein}g</span></div>
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="relative w-full h-3 bg-gray-800 rounded-full overflow-hidden mb-6">
          <div class="absolute top-0 left-0 h-full bg-orange-400 rounded-full transition-all duration-500" style={`width: ${percent}%`}></div>
        </div>

        <!-- Macros Grid -->
        <div class="grid grid-cols-3 gap-2 text-center divide-x divide-white/10">
          {macros.map(m => (
             <div class="px-1">
               <div class={`w-1.5 h-1.5 rounded-full ${m.color} mx-auto mb-1`}></div>
               <div class="text-[10px] text-text-muted uppercase">{m.label}</div>
               <div class="text-xs font-bold">{m.amount}</div>
             </div>
          ))}
        </div>
      </Card>
    </section>

    <!-- Recent Logs -->
    <section>
      <h3 class="text-sm font-bold text-text-muted mb-2 px-1">Today's Logs</h3>
      <div class="bg-surface border border-border rounded-xl divide-y divide-white/5">
        {logs.map(log => (
          <div class="p-3 flex justify-between items-center group">
            <div>
              <div class="font-medium text-sm text-text-main">{log.title}</div>
              <div class="text-[10px] text-text-muted flex gap-2">
                <span>{log.time}</span>
                <span class="text-emerald-400/80">{log.protein} prot</span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="font-mono text-sm text-text-main">{log.calories}</span>
              <button class="text-gray-600 hover:text-red-500 transition-colors p-1" aria-label="Delete">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

  <div slot="actions" class="flex gap-2 w-full max-w-sm mx-auto">
    <Fab variant="secondary" href="/calories/settings" class="flex-1 justify-center"> 
      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149 1.081c.07.47.023.955-.133 1.41-.138.402-.38.746-.689.997a2.535 2.535 0 0 1-1.086.438l-1.46.257a1.125 1.125 0 0 1-1.285-1.07l.149-1.081c.06-.434.333-.806.721-.994Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
      Target
    </Fab>
    <Fab variant="primary" href="/calories/new" class="flex-[2] justify-center"> 
      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Add Log 
    </Fab>
  </div>

</AppShell>
