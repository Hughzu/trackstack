---
import Layout from '@/shared/layouts/Layout.astro';
import '@/shared/styles/global.css';

// MOCK DATA
const config = {
  income: 2215,
  ratios: {
    fund: 60,
    fun: 20,
    future: 20
  }
};

const obligations = [
  { id: 1, name: "Mortgage", amount: 650 },
  { id: 2, name: "Investments", amount: 50 },
  { id: 3, name: "Luminus", amount: 35 },
  { id: 4, name: "Spotify", amount: 15 },
];
---

<Layout>
  <form class="min-h-screen bg-background text-text-main font-sans pb-20 animate-fade-in flex flex-col relative max-w-lg mx-auto">
    
    <header class="flex justify-between items-center p-4 pt-6 border-b border-border bg-background/80 backdrop-blur-md sticky top-0 z-50">
      <a href="/expenses" class="text-text-muted hover:text-text-main text-sm transition-colors">Cancel</a>
      <h1 class="text-base font-bold text-text-main">Settings</h1>
      <button type="button" onclick="window.location.href='/expenses'" class="text-primary font-bold text-sm hover:text-primary/80 transition-colors">
        Save
      </button>
    </header>

    <main class="p-6 flex flex-col gap-8 flex-1">

      <section class="flex flex-col gap-3">
        <h2 class="text-xs text-text-muted uppercase tracking-widest font-bold px-1">Projected Income</h2>
        <div class="bg-surface border border-border rounded-2xl p-4 flex items-center justify-between shadow-sm">
          <div class="flex flex-col">
            <span class="text-sm font-medium">Monthly Net</span>
            <span class="text-[10px] text-text-muted">Sets the budget denominator</span>
          </div>
          <div class="relative w-32">
            <span class="absolute left-0 top-1/2 -translate-y-1/2 text-text-muted">€</span>
            <input 
              type="number" 
              value={config.income}
              class="w-full bg-transparent text-right font-bold text-xl focus:outline-none border-b border-transparent focus:border-primary transition-colors text-text-main placeholder:text-text-muted/30"
            />
          </div>
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <div class="flex justify-between items-end px-1">
          <h2 class="text-xs text-text-muted uppercase tracking-widest font-bold">Ratios</h2>
          <span class="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full font-mono">
            Total: 100%
          </span>
        </div>

        <div class="bg-surface border border-border rounded-2xl p-5 flex flex-col gap-6 shadow-sm">
          
          <div class="space-y-3">
            <div class="flex justify-between text-sm items-center">
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-red-500"></span>
                <span class="font-medium">Fundamentals</span>
              </span>
              <span class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border">{config.ratios.fund}%</span>
            </div>
            <input 
              type="range" 
              min="0" max="100" 
              value={config.ratios.fund}
              class="w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-red-500 hover:accent-red-400 transition-colors"
            />
          </div>

          <div class="space-y-3">
            <div class="flex justify-between text-sm items-center">
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-orange-500"></span>
                <span class="font-medium">Fun</span>
              </span>
              <span class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border">{config.ratios.fun}%</span>
            </div>
            <input 
              type="range" 
              min="0" max="100" 
              value={config.ratios.fun}
              class="w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-orange-500 hover:accent-orange-400 transition-colors"
            />
          </div>

          <div class="space-y-3">
            <div class="flex justify-between text-sm items-center">
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="font-medium">Future</span>
              </span>
              <span class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border">{config.ratios.future}%</span>
            </div>
            <input 
              type="range" 
              min="0" max="100" 
              value={config.ratios.future}
              class="w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-500 hover:accent-emerald-400 transition-colors"
            />
          </div>

        </div>
      </section>

      <section class="flex flex-col gap-3">
        <div class="px-1">
          <h2 class="text-xs text-text-muted uppercase tracking-widest font-bold">Monthly Checklist</h2>
          <p class="text-[10px] text-text-muted mt-0.5">Recurring payments to check off every month.</p>
        </div>
        
        <div class="bg-surface border border-border rounded-2xl overflow-hidden divide-y divide-white/5 shadow-sm">
          {obligations.map(item => (
            <div class="p-3 pl-4 flex justify-between items-center group hover:bg-white/5 transition-colors">
              <div class="font-medium text-sm">{item.name}</div>
              <div class="flex items-center gap-4">
                <span class="font-mono text-sm text-text-muted">€{item.amount}</span>
                <button type="button" class="text-gray-600 hover:text-red-500 transition-colors p-1">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                  </svg>
                </button>
              </div>
            </div>
          ))}

          <div class="p-3 bg-black/20 flex gap-3 items-center">
            <input 
              type="text" 
              placeholder="Name (e.g. Netflix)" 
              class="flex-[2] bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 transition-colors text-text-main"
            />
            <input 
              type="number" 
              placeholder="€" 
              class="flex-1 bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 text-right transition-colors text-text-main"
            />
            <button type="button" class="text-primary hover:text-primary/80 font-bold text-xs bg-primary/10 px-3 py-1.5 rounded-full border border-primary/20 transition-all">
              Add
            </button>
          </div>
        </div>
      </section>

    </main>
  </form>
</Layout>