package components

templ QuickLogForm() {
	<div class="fixed bottom-0 left-0 right-0 z-50 bg-bg-primary/95 backdrop-blur-xl border-t border-white/10 pb-safe">
		<form
			hx-post="/calories/log"
			hx-target="#dashboard-metrics"
			hx-swap="outerHTML"
			hx-indicator="#log-spinner"
			hx-on::after-request="this.reset()"
			class="container mx-auto max-w-md p-3 flex flex-col gap-3"
		>
			<!-- Macros Row (Small inputs) -->
			<div class="flex gap-2 text-sm">
				<div class="relative flex-1">
					<input
						type="number"
						name="calories"
						placeholder="kcal"
						min="1"
						required
						class="w-full pl-2 pr-2 py-1.5 bg-bg-secondary/50 border border-white/5 rounded text-text-primary placeholder-text-muted focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
					/>
				</div>
				<div class="relative flex-1">
					<input
						type="number"
						name="protein"
						placeholder="prot"
						min="0"
						class="w-full pl-2 pr-2 py-1.5 bg-bg-secondary/50 border border-white/5 rounded text-text-primary placeholder-text-muted focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
					/>
				</div>
				<div class="relative flex-1">
					<input
						type="number"
						name="carbs"
						placeholder="carb"
						min="0"
						class="w-full pl-2 pr-2 py-1.5 bg-bg-secondary/50 border border-white/5 rounded text-text-primary placeholder-text-muted focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
					/>
				</div>
				<div class="relative flex-1">
					<input
						type="number"
						name="fat"
						placeholder="fat"
						min="0"
						class="w-full pl-2 pr-2 py-1.5 bg-bg-secondary/50 border border-white/5 rounded text-text-primary placeholder-text-muted focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
					/>
				</div>
			</div>

			<!-- Main Input Row (Message style) -->
			<div class="flex gap-2 items-center">
				<input
					type="text"
					name="name"
					placeholder="What did you eat?"
					required
					autocomplete="off"
					class="flex-1 px-4 h-10 bg-bg-secondary border border-white/5 rounded-full text-text-primary placeholder-text-muted focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all text-sm"
				/>
				
				<button
					type="submit"
					class="flex-none px-4 h-10 rounded-full bg-white text-black font-bold text-xs tracking-wide uppercase flex items-center justify-center hover:bg-opacity-90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-lg shadow-white/10"
				>
					<span class="htmx-indicator-hidden">LOG</span>
					<span id="log-spinner" class="htmx-indicator flex items-center justify-center">
						<svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
						</svg>
					</span>
				</button>
			</div>
		</form>
	</div>
	
	<!-- Spacer to prevent content overlap -->
	<div class="h-32"></div>
}
