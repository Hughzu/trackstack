package components

templ QuickLogForm() {
	<div class="bg-bg-secondary rounded-xl p-4 border border-border-subtle">
		<h3 class="text-sm font-medium text-text-muted mb-3">Quick Log</h3>
		<form
			hx-post="/calories/log"
			hx-target="#dashboard-metrics"
			hx-swap="outerHTML"
			hx-indicator="#log-spinner"
			hx-on::after-request="this.reset()"
			class="flex flex-col gap-3"
		>
			<!-- Meal Name -->
			<div class="flex flex-col gap-1">
				<input
					type="text"
					name="name"
					placeholder="Meal name..."
					required
					class="w-full px-3 py-2 bg-bg-primary border border-border-subtle rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-interactive text-base"
				/>
			</div>
			<!-- Numeric Inputs Row -->
			<div class="flex gap-2">
				<div class="flex-1 flex flex-col gap-1">
					<input
						type="number"
						name="calories"
						placeholder="kcal"
						min="1"
						required
						class="w-full px-3 py-2 bg-bg-primary border border-border-subtle rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-interactive text-base"
					/>
				</div>
				<div class="flex-1 flex flex-col gap-1">
					<input
						type="number"
						name="protein"
						placeholder="protein (g)"
						min="0"
						value="0"
						class="w-full px-3 py-2 bg-bg-primary border border-border-subtle rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-interactive text-base"
					/>
				</div>
			</div>
			<!-- Optional Fields (Carbs/Fat) -->
			<details class="text-sm">
				<summary class="text-text-muted cursor-pointer hover:text-text-primary transition-colors">More options (carbs, fat)</summary>
				<div class="flex gap-2 mt-2">
					<div class="flex-1">
						<input
							type="number"
							name="carbs"
							placeholder="carbs (g)"
							min="0"
							value="0"
							class="w-full px-3 py-2 bg-bg-primary border border-border-subtle rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-interactive text-base"
						/>
					</div>
					<div class="flex-1">
						<input
							type="number"
							name="fat"
							placeholder="fat (g)"
							min="0"
							value="0"
							class="w-full px-3 py-2 bg-bg-primary border border-border-subtle rounded-lg text-text-primary placeholder-text-muted focus:outline-none focus:border-interactive text-base"
						/>
					</div>
				</div>
			</details>
			<!-- Submit Button -->
			<button
				type="submit"
				class="w-full py-3 px-4 bg-interactive hover:bg-interactive-hover text-white font-medium rounded-lg transition-colors flex items-center justify-center gap-2 mt-1"
			>
				<span>Log Meal</span>
				<span id="log-spinner" class="htmx-indicator hidden">
					<svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
				</span>
			</button>
		</form>
	</div>
}
