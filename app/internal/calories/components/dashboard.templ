package components

import (
	"github.com/23St/trackstack/internal/calories"
	commonComponents "github.com/23St/trackstack/internal/common/components"
)

templ Dashboard(summary *calories.DailySummary) {
	@commonComponents.Layout("TrackStack - Dashboard") {
		<div class="container mx-auto px-4 py-8">
			<div class="flex flex-col gap-8 max-w-md mx-auto">
				<!-- Calories Metric (Hero) -->
				@MetricCard(summary.Calories, "kcal remaining", true)
				
				<!-- Protein Metric (Secondary) -->
				@MetricCard(summary.Protein, "g protein remaining", false)
			</div>
		</div>
	}
}
