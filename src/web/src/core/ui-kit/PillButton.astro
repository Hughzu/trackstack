---
interface Props {
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: any;
}

const { type = "button", class: className, ...rest } = Astro.props;

const baseClasses =
  "px-3 py-2 rounded-xl border border-primary/20 bg-panel hover:border-primary/50 hover:bg-surface/80 transition-colors whitespace-nowrap active:scale-95 disabled:opacity-50 disabled:pointer-events-none";
---

<button type={type} class:list={[baseClasses, className]} {...rest}>
  <slot />
</button>
