---
interface Props {
  title?: string;
  href?: string;
  variant?: "default" | "highlight" | "glass";
  class?: string;
}

const { title, href, variant = "default", class: className } = Astro.props;

const baseClasses =
  "relative flex flex-col p-5 rounded-2xl border transition-all duration-300 overflow-hidden";
const variants = {
  default: "bg-surface border-border text-text-main hover:border-gray-500",
  highlight:
    "bg-surface border-primary/20 shadow-lg shadow-black/40 ring-1 ring-primary/20",
  glass: "bg-surface/50 backdrop-blur-md border-white/5 text-text-main",
};

const Tag = href ? "a" : "div";
---

<Tag href={href} class:list={[baseClasses, variants[variant], className]}>
  {
    title && (
      <div class="mb-4">
        <h3 class="text-xs font-bold text-primary uppercase tracking-widest">
          {title}
        </h3>
      </div>
    )
  }
  <div class="flex-1 flex flex-col">
    <slot />
  </div>
</Tag>
