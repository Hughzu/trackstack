---
interface Props {
  variant?: "default" | "danger";
  ariaLabel?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: any;
}

const {
  variant = "default",
  ariaLabel,
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const baseClasses =
  "w-10 h-10 flex items-center justify-center rounded-full transition-colors";

const variants = {
  default: "text-text-muted hover:text-text-main active:bg-white/5",
  danger: "text-gray-600 hover:text-red-500 active:bg-red-500/10"
};
---

<button
  type={type}
  aria-label={ariaLabel}
  class:list={[baseClasses, variants[variant], className]}
  {...rest}
>
  <slot />
</button>
