---
interface Props {
  class?: string;
  panelClass?: string;
}

const { class: className, panelClass } = Astro.props;
---

<div class:list={["relative", className]} data-menu-root>
  <div data-menu-trigger>
    <slot name="trigger" />
  </div>
  <div
    class:list={[
      "absolute right-0 mt-3 hidden min-w-[12rem] rounded-2xl border border-border bg-surface p-2 shadow-xl shadow-black/40 backdrop-blur-sm",
      panelClass
    ]}
    data-menu-panel
    role="menu"
  >
    <slot />
  </div>
</div>

<script>
  const roots = Array.from(document.querySelectorAll("[data-menu-root]"));

  const getPanel = (root) => root.querySelector("[data-menu-panel]");
  const getTrigger = (root) => root.querySelector("[data-menu-trigger]");
  const getControl = (root) => getTrigger(root)?.firstElementChild;

  const isOpen = (root) => {
    const panel = getPanel(root);
    return panel && !panel.classList.contains("hidden");
  };

  const setOpen = (root, open) => {
    const panel = getPanel(root);
    if (!panel) return;
    panel.classList.toggle("hidden", !open);
    const control = getControl(root);
    if (control) {
      control.setAttribute("aria-expanded", String(open));
    }
  };

  const closeAll = (except) => {
    roots.forEach((root) => {
      if (root !== except) {
        setOpen(root, false);
      }
    });
  };

  roots.forEach((root) => {
    if (root.dataset.menuBound === "true") return;
    root.dataset.menuBound = "true";
    const trigger = getTrigger(root);

    trigger?.addEventListener("click", (event) => {
      event.stopPropagation();
      const next = !isOpen(root);
      closeAll(root);
      setOpen(root, next);
    });
  });

  if (!window.__dropdownMenuGlobalBound) {
    window.__dropdownMenuGlobalBound = true;

    document.addEventListener("click", (event) => {
      roots.forEach((root) => {
        if (!isOpen(root)) return;
        if (!root.contains(event.target)) {
          setOpen(root, false);
        }
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      roots.forEach((root) => setOpen(root, false));
    });
  }
</script>
