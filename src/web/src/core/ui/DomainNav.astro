---
import { appConfig, type AppDomain } from "@app/config";

interface Props {
  current: string;
  domains?: AppDomain[];
}

const { current, domains = appConfig.domains } = Astro.props;
---

<nav
  class="overflow-x-auto no-scrollbar pb-2 px-4 max-w-3xl mx-auto flex gap-6 mask-fade-right"
>
  {
    domains.map((d) => (
      <a
        href={d.href}
        class:list={[
          "text-sm font-medium whitespace-nowrap transition-all duration-200 select-none",
          current === d.id
            ? "text-primary border-b-2 border-primary pb-1"
            : "text-text-muted hover:text-text-main",
        ]}
      >
        {d.label}
      </a>
    ))
  }
</nav>

<style>
  /* Hide scrollbar but allow functionality */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
