---
interface Props {
  isEmpty?: boolean;
  emptyMessage?: string;
  class?: string;
  [key: string]: any;
}

const {
  isEmpty = false,
  emptyMessage = "Nothing here yet.",
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "bg-panel border border-primary/20 rounded-2xl shadow-lg shadow-black/40 divide-y divide-white/5 overflow-hidden",
    className
  ]}
  {...rest}
>
  <slot />
  {isEmpty && (
    <div class="p-4 text-center text-text-muted text-xs italic">
      {emptyMessage}
    </div>
  )}
</div>
