---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["p-3 flex justify-between items-center group", className]}>
  <div class="min-w-0">
    <slot name="left" />
  </div>
  <div class="flex items-center gap-3">
    <slot name="right" />
  </div>
</div>
