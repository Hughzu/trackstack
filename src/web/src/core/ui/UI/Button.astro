---
interface Props {
    variant?: "primary" | "secondary" | "danger" | "ghost" | "outline";
    size?: "sm" | "md" | "lg" | "icon";
    href?: string;
    type?: "button" | "submit" | "reset";
    class?: string;
    [key: string]: any;
}

const {
    variant = "primary",
    size = "md",
    href,
    type = "button",
    class: className,
    ...rest
} = Astro.props;

const baseStyles =
    "inline-flex items-center justify-center rounded-xl font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-background disabled:opacity-50 disabled:pointer-events-none cursor-pointer";

const variants = {
    primary:
        "bg-primary text-background hover:bg-primary/90 shadow-lg shadow-primary/20",
    secondary:
        "bg-surface text-text-main hover:bg-surface/80 border border-border",
    danger: "bg-red-500/10 text-red-500 hover:bg-red-500/20 border border-red-500/20",
    ghost: "hover:bg-surface text-text-muted hover:text-text-main",
    outline:
        "border-2 border-border text-text-muted hover:border-primary hover:text-primary bg-transparent",
};

const sizes = {
    sm: "h-8 px-3 text-xs gap-1.5",
    md: "h-10 px-4 py-2 text-sm gap-2",
    lg: "h-12 px-6 text-base gap-2.5",
    icon: "h-10 w-10 p-2",
};

const Tag = href ? "a" : "button";
---

<Tag
    href={href}
    type={!href ? type : undefined}
    class:list={[baseStyles, variants[variant], sizes[size], className]}
    {...rest}
>
    <slot name="icon" />
    <slot />
</Tag>
