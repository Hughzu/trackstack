---
interface Props {
  variant?: "primary" | "secondary";
  href?: string;
  onclick?: string;
  class?: string;
}

const { variant = "primary", href, onclick, class: className } = Astro.props;

const baseStyles =
  "shadow-lg px-6 py-3 rounded-full font-medium flex items-center gap-2 active:scale-95 transition-transform cursor-pointer";
const variants = {
  primary: "bg-primary text-surface hover:brightness-110",
  secondary: "bg-surface text-text-main border border-border hover:bg-gray-50",
};

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  onclick={onclick}
  class:list={[baseStyles, variants[variant], className]}
>
  <slot name="icon" />
  <span class="whitespace-nowrap"><slot /></span>
</Tag>
