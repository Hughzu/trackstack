---
interface Props {
  title: string;
  cancelHref: string;
  submitLabel?: string;
  formId?: string;
  class?: string;
}

const {
  title,
  cancelHref,
  submitLabel = "Save",
  formId,
  class: className
} = Astro.props;
---

<form
  id={formId}
  class:list={[
    "min-h-screen bg-background flex flex-col animate-fade-in relative max-w-lg mx-auto text-text-main font-sans",
    className
  ]}
>
  <header
    class="flex justify-between items-center p-4 pt-6 border-b border-border bg-background/80 backdrop-blur-md sticky top-0 z-50"
  >
    <a
      href={cancelHref}
      class="text-text-muted hover:text-text-main text-sm transition-colors"
    >
      Cancel
    </a>
    <h1 class="text-base font-bold">{title}</h1>
    <button
      type="submit"
      class="text-primary font-bold text-sm hover:text-primary/80 transition-colors"
    >
      {submitLabel}
    </button>
  </header>

  <main class="flex-1 p-6 flex flex-col gap-8">
    <slot />
  </main>
</form>
