---
import List from "@/core/ui/UI/List.astro";
import ListRow from "@/core/ui/UI/ListRow.astro";
import IconButton from "@/core/ui/UI/IconButton.astro";

interface Props {
  history: {
    id: string;
    title: string;
    amount: number;
    category: string;
    date: string;
    type: string;
  }[];
}

const { history } = Astro.props;

const formatCategory = (category: string) => {
  if (category === "fun") return "Fun";
  if (category === "future") return "Future";
  return "Fund.";
};

const categoryClass = (category: string) => {
  if (category === "fun") return "text-orange-400";
  if (category === "future") return "text-emerald-400";
  return "text-red-400";
};

const formatDateLabel = (dateValue: string) => {
  const date = new Date(`${dateValue}T00:00:00`);
  const today = new Date();
  const startToday = new Date(
    today.getFullYear(),
    today.getMonth(),
    today.getDate(),
  );
  const startDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());
  const diffDays = Math.round(
    (startToday.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24),
  );
  if (diffDays === 0) return "Today";
  if (diffDays === 1) return "Yesterday";
  return date.toLocaleDateString("en-GB", { day: "2-digit", month: "short" });
};
---

<section>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-2 px-1">
    <h3 class="text-sm font-bold text-text-muted">History</h3>
    <div class="flex items-center gap-2" data-expense-filters>
      <button
        class="px-2.5 py-1 rounded-full text-[10px] uppercase tracking-widest border border-white/10 text-text-muted bg-white/10"
        data-expense-filter="all"
        type="button"
      >
        All
      </button>
      <button
        class="px-2.5 py-1 rounded-full text-[10px] uppercase tracking-widest border border-red-500/40 text-red-300 hover:bg-red-500/10 opacity-50"
        data-expense-filter="fund"
        type="button"
      >
        Fund.
      </button>
      <button
        class="px-2.5 py-1 rounded-full text-[10px] uppercase tracking-widest border border-orange-500/40 text-orange-300 hover:bg-orange-500/10 opacity-50"
        data-expense-filter="fun"
        type="button"
      >
        Fun
      </button>
      <button
        class="px-2.5 py-1 rounded-full text-[10px] uppercase tracking-widest border border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/10 opacity-50"
        data-expense-filter="future"
        type="button"
      >
        Future
      </button>
    </div>
  </div>

  <List
    data-expense-history
    isEmpty={history.length === 0}
    emptyMessage="No expenses yet for this sheet."
  >
    {
      history.map((tx) => (
        <ListRow data-expense-item data-expense-category={tx.category}>
          <div slot="left">
            <div class="font-medium text-sm flex items-center gap-2">
              {tx.title}
              {tx.type === "recurring" && (
                <span class="text-[8px] border border-white/10 px-1 rounded text-text-muted">
                  AUTO
                </span>
              )}
              {tx.type === "checklist" && (
                <span class="text-[8px] border border-white/10 px-1 rounded text-text-muted">
                  CHECK
                </span>
              )}
            </div>
            <div class="text-[10px] text-text-muted">
              {formatDateLabel(tx.date)} •{" "}
              <span class={categoryClass(tx.category)}>
                {formatCategory(tx.category)}
              </span>
            </div>
          </div>
          <div slot="right" class="flex items-center gap-2">
            <span class="font-mono text-sm text-red-400">-€{tx.amount}</span>
            <IconButton
              variant="danger"
              ariaLabel="Delete"
              type="button"
              data-expense-delete
              data-expense-id={tx.id}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"
                />
              </svg>
            </IconButton>
          </div>
        </ListRow>
      ))
    }
  </List>
</section>

<script>
  const filterRoot = document.querySelector("[data-expense-filters]");
  const historyRoot = document.querySelector("[data-expense-history]");

  if (filterRoot && historyRoot) {
    filterRoot.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest("[data-expense-filter]");
      if (!button) return;

      const value = button.getAttribute("data-expense-filter") || "all";
      const buttons = filterRoot.querySelectorAll("[data-expense-filter]");
      buttons.forEach((btn) => {
        if (!(btn instanceof HTMLElement)) return;
        const isActive = btn.getAttribute("data-expense-filter") === value;
        if (isActive) {
          btn.classList.add("bg-white/10");
          btn.classList.remove("opacity-50");
        } else {
          btn.classList.remove("bg-white/10");
          btn.classList.add("opacity-50");
        }
      });

      const rows = historyRoot.querySelectorAll("[data-expense-item]");
      rows.forEach((row) => {
        if (!(row instanceof HTMLElement)) return;
        const category = row.getAttribute("data-expense-category");
        if (value === "all" || category === value) {
          row.classList.remove("hidden");
        } else {
          row.classList.add("hidden");
        }
      });
    });
  }
</script>
