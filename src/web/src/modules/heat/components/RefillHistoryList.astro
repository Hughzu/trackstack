---
import type { Refill } from "../types";

interface Props {
  history: Refill[];
}

const { history } = Astro.props;

const formatDate = (date: Date) => {
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
};
---

<section class="mt-4">
  <h3 class="text-sm font-bold text-text-muted mb-2 px-1">Refill History</h3>
  <div
    class="bg-[#1e2128] border border-primary/20 rounded-2xl shadow-lg shadow-black/40 divide-y divide-white/5 overflow-hidden"
    data-refill-history
  >
    {
      history.map((item) => (
        <div class="p-3 flex justify-between items-center group">
          <div>
            <div class="font-medium text-sm text-text-main">
              {formatDate(item.date)}
            </div>
            {item.season && (
              <div class="text-[10px] text-text-muted">
                Season {item.season}
              </div>
            )}
            {item.temperature !== undefined && (
              <div class="text-[10px] text-text-muted">
                Avg Temp: {item.temperature}°C
              </div>
            )}
          </div>
          <div class="flex items-center gap-3">
            <div class="text-right">
              <div class="font-mono text-sm text-text-main">
                {item.bags} Bag{item.bags !== 1 ? "s" : ""}
              </div>
              <div class="text-[10px] text-text-muted">{item.weightKg}kg</div>
            </div>
            <button
              class="text-gray-600 hover:text-red-500 transition-colors w-10 h-10 flex items-center justify-center rounded-full -mr-2 active:bg-red-500/10"
              aria-label="Delete refill"
              data-refill-delete
              data-refill-id={item.id}
              type="button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"
                />
              </svg>
            </button>
          </div>
        </div>
      ))
    }

    {
      history.length === 0 && (
        <div class="p-4 text-center text-text-muted text-xs italic">
          No refill history found.
        </div>
      )
    }
  </div>
</section>
