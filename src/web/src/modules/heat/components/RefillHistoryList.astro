---
import type { Refill } from '../types';

interface Props {
  history: Refill[];
}

const { history } = Astro.props;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
};
---

<section class="mt-4">
  <h3 class="text-sm font-bold text-text-muted mb-2 px-1">Refill History</h3>
  <div class="bg-surface border border-border rounded-xl divide-y divide-white/5" data-refill-history>
    {history.map(item => (
      <div class="p-3 flex justify-between items-center group">
        <div>
          <div class="font-medium text-sm text-text-main">{formatDate(item.date)}</div>
          {item.temperature !== undefined && (
            <div class="text-[10px] text-text-muted">Avg Temp: {item.temperature}°C</div>
          )}
        </div>
        <div class="flex items-center gap-3">
          <div class="text-right">
            <div class="font-mono text-sm text-text-main">{item.bags} Bag{item.bags !== 1 ? 's' : ''}</div>
            <div class="text-[10px] text-text-muted">{item.weightKg}kg</div>
          </div>
          <button
            class="text-gray-600 hover:text-red-500 transition-colors p-1"
            aria-label="Delete refill"
            data-refill-delete
            data-refill-id={item.id}
            type="button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
          </button>
        </div>
      </div>
    ))}
    
    {history.length === 0 && (
      <div class="p-4 text-center text-text-muted text-xs italic">
        No refill history found.
      </div>
    )}
  </div>
</section>

<div class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm" data-refill-modal>
  <div class="w-[90%] max-w-xs rounded-2xl border border-border bg-surface p-4 shadow-lg">
    <h4 class="text-sm font-bold text-text-main">Delete refill?</h4>
    <p class="mt-1 text-xs text-text-muted">
      This removes the entry from your history.
    </p>
    <div class="mt-4 flex gap-2">
      <button
        class="flex-1 rounded-lg border border-border bg-surface px-3 py-2 text-xs text-text-muted hover:text-text-main hover:border-primary/50 transition-colors"
        data-refill-cancel
        type="button"
      >
        Cancel
      </button>
      <button
        class="flex-1 rounded-lg bg-red-500/20 px-3 py-2 text-xs font-semibold text-red-400 hover:bg-red-500/30 transition-colors"
        data-refill-confirm
        type="button"
      >
        Delete
      </button>
    </div>
  </div>
</div>

<script>
  const historyRoot = document.querySelector('[data-refill-history]');
  const modal = document.querySelector('[data-refill-modal]');
  const cancelButton = modal?.querySelector('[data-refill-cancel]');
  const confirmButton = modal?.querySelector('[data-refill-confirm]');
  let pendingId = null;

  const openModal = (id) => {
    pendingId = id;
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  };

  const closeModal = () => {
    pendingId = null;
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  };

  if (modal) {
    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });
  }

  if (cancelButton) {
    cancelButton.addEventListener('click', () => closeModal());
  }

  if (confirmButton) {
    confirmButton.addEventListener('click', async () => {
      if (!pendingId) return;

      confirmButton.setAttribute('disabled', 'true');
      const originalText = confirmButton.textContent;
      confirmButton.textContent = 'Deleting...';

      try {
        const response = await fetch('/api/heat/refill', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ id: pendingId })
        });

        if (response.ok) {
          window.location.reload();
          return;
        }
      } catch {
        // noop
      }

      confirmButton.removeAttribute('disabled');
      confirmButton.textContent = originalText || 'Delete';
      window.alert('Unable to delete refill. Please try again.');
    });
  }

  if (historyRoot) {
    historyRoot.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest('[data-refill-delete]');
      if (!button) return;

      const refillId = button.getAttribute('data-refill-id');
      if (!refillId) return;

      openModal(refillId);
    });
  }
</script>
