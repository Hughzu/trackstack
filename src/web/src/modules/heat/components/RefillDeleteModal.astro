---
import ConfirmModal from "@/core/ui-kit/ConfirmModal.astro";

const MODAL_ID = "refill-delete-modal";
---

<ConfirmModal
  id={MODAL_ID}
  title="Delete refill?"
  description="This removes the entry from your history. This action cannot be undone."
  confirmLabel="Delete"
  confirmLoadingLabel="Deleting..."
  triggerAttribute="data-refill-delete"
  idAttribute="data-refill-id"
  endpoint="/api/heat/refill"
  method="DELETE"
  errorMessage="Unable to delete refill. Please try again."
/>
