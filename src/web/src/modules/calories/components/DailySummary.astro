---
import Card from "@/core/ui/UI/Card.astro";
import PercentageBar from "@/core/ui/UI/PercentageBar.astro";

interface Props {
  summary: {
    consumed: number;
    protein: number;
    carbs: number;
    fat: number;
    target: {
      targetKcal: number;
      targetProteinG: number;
    };
  };
}

const { summary } = Astro.props;

const percent = summary.target.targetKcal
  ? Math.min((summary.consumed / summary.target.targetKcal) * 100, 100)
  : 0;

const macroTotal = summary.carbs + summary.fat + summary.protein;
const macros = [
  {
    label: "Carbs",
    amount: `${summary.carbs}g`,
    percent: macroTotal ? Math.round((summary.carbs / macroTotal) * 100) : 0,
    color: "bg-orange-400",
  },
  {
    label: "Fat",
    amount: `${summary.fat}g`,
    percent: macroTotal ? Math.round((summary.fat / macroTotal) * 100) : 0,
    color: "bg-yellow-400",
  },
  {
    label: "Protein",
    amount: `${summary.protein}g`,
    percent: macroTotal
      ? Math.round((summary.protein / macroTotal) * 100)
      : 0,
    color: "bg-emerald-400",
  },
];
---

<Card variant="highlight">
  <div class="flex justify-between items-start mb-6">
    <div>
      <span class="text-xs text-text-muted uppercase tracking-widest">
        Daily Intake
      </span>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-text-main">
          {summary.consumed}
        </span>
        <span class="text-sm font-mono text-text-muted">
          / {summary.target.targetKcal} kcal
        </span>
      </div>
    </div>
    <div class="text-right">
      <span class="text-xs text-text-muted uppercase tracking-widest">
        Protein
      </span>
      <div class="text-sm font-bold text-primary">
        {summary.protein}g
        <span class="text-text-muted font-normal">
          / {summary.target.targetProteinG}g
        </span>
      </div>
    </div>
  </div>

  <div class="mb-6">
    <PercentageBar segments={[{ percent, color: "bg-primary" }]} />
  </div>

  <div class="grid grid-cols-3 gap-2 text-center divide-x divide-white/10">
    {
      macros.map((m) => (
        <div class="px-1">
          <div class="text-[10px] text-text-muted uppercase">{m.label}</div>
          <div class="text-xs font-bold">{m.amount}</div>
          <div class={`h-1 w-full rounded-full mt-1 ${m.color} opacity-50`} />
        </div>
      ))
    }
  </div>
</Card>
