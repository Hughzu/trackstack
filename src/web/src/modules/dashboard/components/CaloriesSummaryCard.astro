---
import Card from "@/core/ui-kit/Card.astro";
import PercentageBar from "@/core/ui-kit/PercentageBar.astro";

interface Props {
  dashboard: {
    calories: {
      consumed: number;
      target: number;
      percent: number;
      protein: number;
    };
  };
}

const { dashboard } = Astro.props;
---

<Card variant="highlight" title="Daily Intake" href="/calories">
  <div class="flex justify-between items-start mb-4">
    <div>
      <span class="text-xs text-text-muted uppercase tracking-widest">Consumed</span>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-text-main">
          {dashboard.calories.consumed}
        </span>
        <span class="text-sm font-mono text-text-muted">
          / {dashboard.calories.target} kcal
        </span>
      </div>
    </div>
    <div class="text-right">
      <span class="text-xs text-text-muted uppercase tracking-widest">Protein</span>
      <div class="text-sm font-bold text-primary">
        {dashboard.calories.protein}g
      </div>
    </div>
  </div>

  <div class="mb-1">
    <PercentageBar
      segments={[{ percent: dashboard.calories.percent, color: "bg-primary" }]}
    />
  </div>
</Card>
