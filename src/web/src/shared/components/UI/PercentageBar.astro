---
interface Segment {
  percent: number;
  color: string; // Tailwind class, e.g., 'bg-emerald-500'
  label?: string;
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
---

<div class="w-full h-2 flex rounded-full overflow-hidden bg-gray-800 mb-2">
  {segments.map(seg => (
    <div style={`width: ${seg.percent}%`} class:list={[seg.color, "h-full"]}></div>
  ))}
</div>
<div class="flex justify-between text-[10px] text-text-muted font-mono">
  {segments.filter(s => s.label).map(s => (
    <span>{s.label} {s.percent}%</span>
  ))}
</div>