---
import AppShell from '@/shared/layouts/AppShell.astro';
import Card from '@/shared/components/UI/Card.astro';
import Fab from '@/shared/components/UI/Fab.astro';
import { caloriesService } from '@/modules/calories/services/caloriesService';
import { getCurrentUserId } from '@/shared/auth/currentUser';

const currentUserId = getCurrentUserId();
const summary = caloriesService.getTodaySummary(currentUserId);
const logs = caloriesService.getTodayLogs(currentUserId);
const percent = summary.target.targetKcal
  ? Math.min((summary.consumed / summary.target.targetKcal) * 100, 100)
  : 0;

const macroTotal = summary.carbs + summary.fat + summary.protein;
const macros = [
  {
    label: 'Carbs',
    amount: `${summary.carbs}g`,
    percent: macroTotal ? Math.round((summary.carbs / macroTotal) * 100) : 0,
    color: 'bg-orange-400'
  },
  {
    label: 'Fat',
    amount: `${summary.fat}g`,
    percent: macroTotal ? Math.round((summary.fat / macroTotal) * 100) : 0,
    color: 'bg-yellow-400'
  },
  {
    label: 'Protein',
    amount: `${summary.protein}g`,
    percent: macroTotal ? Math.round((summary.protein / macroTotal) * 100) : 0,
    color: 'bg-emerald-400'
  },
];

const formatTime = (date: Date) =>
  date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
---

<AppShell title="Health" currentDomain="calories">
  
  <div class="flex flex-col gap-5 pb-24">

    <!-- Summary Card -->
    <section>
      <Card variant="highlight">
        <div class="flex justify-between items-start mb-6">
          <div>
            <span class="text-xs text-text-muted uppercase tracking-widest">Daily Intake</span>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-bold text-text-main">{summary.consumed}</span>
              <span class="text-sm font-mono text-text-muted">/ {summary.target.targetKcal} kcal</span>
            </div>
          </div>
          <div class="text-right">
             <span class="text-xs text-text-muted uppercase tracking-widest">Protein</span>
             <div class="text-sm font-bold text-emerald-400">{summary.protein}g <span class="text-text-muted font-normal">/ {summary.target.targetProteinG}g</span></div>
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="relative w-full h-3 bg-gray-800 rounded-full overflow-hidden mb-6">
          <div class="absolute top-0 left-0 h-full bg-orange-400 rounded-full transition-all duration-500" style={`width: ${percent}%`}></div>
        </div>

        <!-- Macros Grid -->
        <div class="grid grid-cols-3 gap-2 text-center divide-x divide-white/10">
          {macros.map(m => (
             <div class="px-1">
               <div class={`w-1.5 h-1.5 rounded-full ${m.color} mx-auto mb-1`}></div>
               <div class="text-[10px] text-text-muted uppercase">{m.label}</div>
               <div class="text-xs font-bold">{m.amount}</div>
             </div>
          ))}
        </div>
      </Card>
    </section>

    <!-- Recent Logs -->
    <section>
      <h3 class="text-sm font-bold text-text-muted mb-2 px-1">Today's Logs</h3>
      <div class="bg-[#1e2128] border border-primary/20 rounded-2xl shadow-lg shadow-black/40 divide-y divide-white/5 overflow-hidden" data-calorie-history>
        {logs.map(log => (
          <div class="p-3 flex justify-between items-center group">
            <div>
              <div class="font-medium text-sm text-text-main">{log.title ?? 'Untitled'}</div>
              <div class="text-[10px] text-text-muted flex gap-2">
                <span>{formatTime(log.dateTime)}</span>
                <span class="text-emerald-400/80">{log.proteinG}g prot</span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="font-mono text-sm text-text-main">{log.calories}</span>
              <button
                class="text-gray-600 hover:text-red-500 transition-colors p-1"
                aria-label="Delete"
                data-calorie-delete
                data-calorie-id={log.id}
                type="button"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              </button>
            </div>
          </div>
        ))}
        {logs.length === 0 && (
          <div class="p-4 text-center text-text-muted text-xs italic">
            No logs yet for today.
          </div>
        )}
      </div>
    </section>

  </div>

  <div slot="actions" class="flex gap-2 w-full max-w-sm mx-auto">
    <Fab variant="secondary" href="/calories/settings" class="flex-1 justify-center"> 
      <svg
        slot="icon"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-5"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"
        ></path><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path></svg>
      Settings
    </Fab>
    <Fab variant="primary" href="/calories/new" class="flex-2 justify-center">
      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Add Meal
    </Fab>
  </div>

</AppShell>

<div class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm" data-calorie-modal>
  <div class="w-[90%] max-w-xs rounded-2xl border border-border bg-surface p-4 shadow-lg">
    <h4 class="text-sm font-bold text-text-main">Delete log?</h4>
    <p class="mt-1 text-xs text-text-muted">
      This removes the entry from today’s list.
    </p>
    <div class="mt-4 flex gap-2">
      <button
        class="flex-1 rounded-lg border border-border bg-surface px-3 py-2 text-xs text-text-muted hover:text-text-main hover:border-primary/50 transition-colors"
        data-calorie-cancel
        type="button"
      >
        Cancel
      </button>
      <button
        class="flex-1 rounded-lg bg-red-500/20 px-3 py-2 text-xs font-semibold text-red-400 hover:bg-red-500/30 transition-colors"
        data-calorie-confirm
        type="button"
      >
        Delete
      </button>
    </div>
  </div>
</div>

<script>
  const historyRoot = document.querySelector('[data-calorie-history]');
  const modal = document.querySelector('[data-calorie-modal]');
  const cancelButton = modal?.querySelector('[data-calorie-cancel]');
  const confirmButton = modal?.querySelector('[data-calorie-confirm]');
  let pendingId = null;

  const openModal = (id) => {
    pendingId = id;
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  };

  const closeModal = () => {
    pendingId = null;
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  };

  if (modal) {
    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });
  }

  if (cancelButton) {
    cancelButton.addEventListener('click', () => closeModal());
  }

  if (confirmButton) {
    confirmButton.addEventListener('click', async () => {
      if (!pendingId) return;

      confirmButton.setAttribute('disabled', 'true');
      const originalText = confirmButton.textContent;
      confirmButton.textContent = 'Deleting...';

      try {
        const response = await fetch('/api/calories/log', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ id: pendingId })
        });

        if (response.ok) {
          window.location.reload();
          return;
        }
      } catch {
        // noop
      }

      confirmButton.removeAttribute('disabled');
      confirmButton.textContent = originalText || 'Delete';
      window.alert('Unable to delete log. Please try again.');
    });
  }

  if (historyRoot) {
    historyRoot.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest('[data-calorie-delete]');
      if (!button) return;

      const logId = button.getAttribute('data-calorie-id');
      if (!logId) return;

      openModal(logId);
    });
  }
</script>
