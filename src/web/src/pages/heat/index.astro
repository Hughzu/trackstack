---
import AppShell from "@/core/layouts/AppShell.astro";
import Fab from "@/core/ui/UI/Fab.astro";
import HeatStatusCard from "@/modules/heat/components/HeatStatusCard.astro";
import SeasonSnapshotCard from "@/modules/heat/components/SeasonSnapshotCard.astro";
import RefillHistoryList from "@/modules/heat/components/RefillHistoryList.astro";
import { heatService } from "@/modules/heat/services/heatService";
import { getCurrentUserId } from "@/core/auth/currentUser";

// Fetch Data
const currentUserId = getCurrentUserId();
const daysSinceRefill = await heatService.getDaysSinceLastRefill(currentUserId);
const seasonSnapshot = await heatService.getSeasonSnapshot(currentUserId);

const historyPage = await heatService.getHistory(1, 20, currentUserId);
---

<AppShell title="Heating" currentDomain="heat">
  <div class="flex flex-col gap-5 pb-24">
    <HeatStatusCard daysSinceRefill={daysSinceRefill} />
    <SeasonSnapshotCard
      seasonLabel={seasonSnapshot.seasonLabel}
      seasonToDate={seasonSnapshot.seasonToDate}
      lastSeasonToDate={seasonSnapshot.lastSeasonToDate}
    />
    <RefillHistoryList history={historyPage.data} />
  </div>

  <div slot="actions" class="flex gap-2 w-full max-w-sm mx-auto">
    <div class="flex-1 justify-center">
      <Fab variant="secondary" href="/heat/settings">
        <svg
          slot="icon"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-5"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"
          ></path><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path></svg
        >
        Settings
      </Fab>
    </div>
    <div class="flex-2 justify-center">
      <Fab variant="primary" href="/heat/new">
        <svg
          slot="icon"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-5"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 4.5v15m7.5-7.5h-15"></path></svg
        >
        Add Bags
      </Fab>
    </div>
  </div>
</AppShell>

<div
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm"
  data-refill-modal
>
  <div
    class="w-[90%] max-w-xs rounded-2xl border border-border bg-surface p-4 shadow-lg"
  >
    <h4 class="text-sm font-bold text-text-main">Delete refill?</h4>
    <p class="mt-1 text-xs text-text-muted">
      This removes the entry from your history.
    </p>
    <div class="mt-4 flex gap-2">
      <button
        class="flex-1 rounded-lg border border-border bg-surface px-3 py-2 text-xs text-text-muted hover:text-text-main hover:border-primary/50 transition-colors"
        data-refill-cancel
        type="button"
      >
        Cancel
      </button>
      <button
        class="flex-1 rounded-lg bg-red-500/20 px-3 py-2 text-xs font-semibold text-red-400 hover:bg-red-500/30 transition-colors"
        data-refill-confirm
        type="button"
      >
        Delete
      </button>
    </div>
  </div>
</div>

<script>
  const historyRoot = document.querySelector("[data-refill-history]");
  const modal = document.querySelector("[data-refill-modal]");
  const cancelButton = modal?.querySelector("[data-refill-cancel]");
  const confirmButton = modal?.querySelector("[data-refill-confirm]");
  let pendingId = null;

  const openModal = (id) => {
    pendingId = id;
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
  };

  const closeModal = () => {
    pendingId = null;
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
  };

  if (modal) {
    modal.addEventListener("click", (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });
  }

  if (cancelButton) {
    cancelButton.addEventListener("click", () => closeModal());
  }

  if (confirmButton) {
    confirmButton.addEventListener("click", async () => {
      if (!pendingId) return;

      confirmButton.setAttribute("disabled", "true");
      const originalText = confirmButton.textContent;
      confirmButton.textContent = "Deleting...";

      try {
        const response = await fetch("/api/heat/refill", {
          method: "DELETE",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ id: pendingId }),
        });

        if (response.ok) {
          window.location.reload();
          return;
        }
      } catch {
        // noop
      }

      confirmButton.removeAttribute("disabled");
      confirmButton.textContent = originalText || "Delete";
      window.alert("Unable to delete refill. Please try again.");
    });
  }

  if (historyRoot) {
    historyRoot.addEventListener("click", async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest("[data-refill-delete]");
      if (!button) return;

      const refillId = button.getAttribute("data-refill-id");
      if (!refillId) return;

      openModal(refillId);
    });
  }
</script>
