---
import AppShell from '@/shared/layouts/AppShell.astro';
import Card from '@/shared/components/UI/Card.astro';
import Fab from '@/shared/components/UI/Fab.astro';

// MOCK DATA
const featured = {
  title: "Spicy Peanut Noodles",
  time: "15 min",
  cals: 450,
  tags: ["Quick", "Vegan"]
};

const categories = ["All", "Breakfast", "Main", "Snacks", "Meal Prep"];

const recipes = [
  { id: 1, title: 'Chicken Tikka Masala', time: '45 min', cals: 650, diff: 'Medium', rating: 5 },
  { id: 2, title: 'Overnight Oats', time: '5 min', cals: 350, diff: 'Easy', rating: 4 },
  { id: 3, title: 'Beef Stir Fry', time: '20 min', cals: 500, diff: 'Easy', rating: 4 },
  { id: 4, title: 'Protein Pancakes', time: '15 min', cals: 400, diff: 'Medium', rating: 3 },
];
---

<AppShell title="Recipes" currentDomain="recipes">
  
  <div class="flex flex-col gap-5 pb-24">

    <!-- Featured Card -->
    <section>
      <h3 class="text-sm font-bold text-text-muted mb-2 px-1">Featured</h3>
      <Card variant="highlight" class="p-0 overflow-hidden relative group cursor-pointer h-48">
        
        <!-- Abstract Image Placeholder -->
        <div class="absolute inset-0 bg-primary/10 group-hover:bg-primary/20 transition-colors">
          <svg class="absolute bottom-0 right-0 w-32 h-32 text-primary/10 -mb-4 -mr-4 transform rotate-12" fill="currentColor" viewBox="0 0 24 24">
             <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
          </svg>
        </div>

        <div class="relative z-10 flex flex-col justify-end h-full p-5">
          <div class="flex gap-2 mb-2">
            {featured.tags.map(tag => (
              <span class="text-[10px] bg-black/40 backdrop-blur-md px-2 py-0.5 rounded text-white border border-white/10">{tag}</span>
            ))}
          </div>
          <h2 class="text-xl font-bold text-text-main mb-1">{featured.title}</h2>
          <div class="flex items-center gap-3 text-xs text-text-muted">
             <span class="flex items-center gap-1">
               <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
               {featured.time}
             </span>
             <span>•</span>
             <span>{featured.cals} kcal</span>
          </div>
        </div>
      </Card>
    </section>

    <!-- Categories -->
    <section class="flex gap-2 overflow-x-auto pb-2 -mx-4 px-4 scrollbar-hide">
      {categories.map((cat, i) => (
        <button class={`
          px-4 py-1.5 rounded-full text-xs font-medium border whitespace-nowrap transition-colors
          ${i === 0 
            ? 'bg-primary text-background border-primary' 
            : 'bg-surface text-text-muted border-border hover:border-primary/50 hover:text-text-main'
          }
        `}>
          {cat}
        </button>
      ))}
    </section>

    <!-- List -->
    <section>
      <div class="grid grid-cols-1 gap-2">
        {recipes.map(recipe => (
          <div class="p-3 rounded-xl border bg-[#1e2128] border-primary/20 shadow-md flex justify-between items-center hover:border-primary/50 transition-colors cursor-pointer group">
            <div class="flex gap-3 items-center">
              <div class="w-12 h-12 rounded-lg bg-white/5 flex items-center justify-center text-text-muted group-hover:text-primary transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
              </div>
              <div>
                <h4 class="text-sm font-bold text-text-main group-hover:text-primary transition-colors">{recipe.title}</h4>
                <div class="flex gap-2 text-[10px] text-text-muted mt-0.5">
                  <span>{recipe.time}</span>
                  <span>•</span>
                  <span>{recipe.diff}</span>
                </div>
              </div>
            </div>
            <div class="text-right">
              <div class="text-xs font-mono text-text-muted">{recipe.cals}</div>
              <div class="text-[10px] text-yellow-500 flex justify-end gap-0.5 mt-1">
                {Array(recipe.rating).fill(0).map(() => (
                  <svg class="w-2 h-2 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

  <div slot="actions" class="flex gap-2 w-full max-w-sm mx-auto">
    <Fab variant="secondary" href="/recipes/search" class="flex-1 justify-center"> 
      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
      Search
    </Fab>
    <Fab variant="primary" href="/recipes/new" class="flex-[2] justify-center"> 
      <svg slot="icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      New Recipe 
    </Fab>
  </div>

</AppShell>
