---
import Layout from "@/app/layouts/Layout.astro";
import "@/core/styles/global.css";
import FormShell from "@/core/ui-kit/FormShell.astro";
import FormCard from "@/core/ui-kit/FormCard.astro";

const categories = [
  {
    id: "fund",
    label: "Fundamentals",
    color:
      "peer-checked:border-red-500 peer-checked:ring-2 peer-checked:ring-red-500/30",
    icon: "🏠",
  },
  {
    id: "fun",
    label: "Fun",
    color:
      "peer-checked:border-orange-500 peer-checked:ring-2 peer-checked:ring-orange-500/30",
    icon: "🎉",
  },
  {
    id: "future",
    label: "Future",
    color:
      "peer-checked:border-emerald-500 peer-checked:ring-2 peer-checked:ring-emerald-500/30",
    icon: "🚀",
  },
];

const today = new Date().toISOString().split("T")[0];
---

<Layout>
  <FormShell title="New Expense" cancelHref="/expenses" formId="expense-form">
    <div class="flex flex-col items-center gap-2 mt-4">
      <label
        for="amount"
        class="text-xs text-text-muted uppercase tracking-widest"
        >Amount</label
      >
      <div class="relative w-full max-w-[200px]">
        <span
          class="absolute left-0 top-1/2 -translate-y-1/2 text-3xl font-bold text-text-muted"
          >€</span
        >
        <input
          type="number"
          id="amount"
          name="amount"
          placeholder="0.00"
          step="0.01"
          required
          autofocus
          class="w-full bg-transparent border-b-2 border-border text-center text-5xl font-bold text-text-main focus:outline-none focus:border-primary pb-2 placeholder:text-text-muted/20"
        />
      </div>
    </div>

    <div class="flex flex-col gap-3">
      <label class="text-xs text-text-muted uppercase tracking-widest px-1"
        >Category</label
      >
      <div class="grid grid-cols-3 gap-3">
        {
          categories.map((cat) => (
            <label class="cursor-pointer group relative">
              <input
                type="radio"
                name="category"
                value={cat.id}
                class="peer sr-only"
                required
              />
              <div
                class={`
              h-24 rounded-2xl border border-border bg-surface 
              flex flex-col items-center justify-center gap-2
              transition-all duration-200
              ${cat.color}
            `}
              >
                <span class="text-2xl group-active:scale-90 transition-transform">
                  {cat.icon}
                </span>
                <span class="text-xs font-medium text-text-muted">
                  {cat.label}
                </span>
              </div>

              <div class="absolute top-2 right-2 opacity-0 peer-checked:opacity-100 transition-opacity">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-4 text-primary"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </div>
            </label>
          ))
        }
      </div>
    </div>

    <FormCard>
      <div class="flex flex-col gap-1">
        <label for="title" class="text-xs text-text-muted ml-1">Title</label>
        <input
          type="text"
          id="title"
          name="title"
          placeholder="e.g. Groceries"
          class="bg-transparent border-b border-border py-2 text-text-main focus:outline-none focus:border-primary transition-colors"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="date" class="text-xs text-text-muted ml-1">Date</label>
        <input
          type="date"
          id="date"
          name="date"
          value={today}
          class="bg-transparent border-b border-border py-2 text-text-main focus:outline-none focus:border-primary transition-colors [color-scheme:dark]"
        />
      </div>
    </FormCard>
  </FormShell>
</Layout>

<script>
  const form = document.getElementById("expense-form");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData);

    try {
      const response = await fetch("/api/expenses/expense", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      if (response.ok) {
        window.location.href = "/expenses";
        return;
      }
    } catch {
      // noop
    }

    window.alert("Failed to save expense.");
  });
</script>
