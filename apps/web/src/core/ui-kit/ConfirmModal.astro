---
import Modal from "@/core/ui-kit/Modal.astro";
import Button from "@/core/ui-kit/Button.astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  confirmLabel?: string;
  cancelLabel?: string;
  confirmLoadingLabel?: string;
  triggerAttribute: string;
  idAttribute?: string;
  endpoint: string;
  method?: "DELETE" | "POST";
  payloadKey?: string;
  sendPayload?: boolean;
  errorMessage?: string;
  successRedirect?: string;
}

const {
  id,
  title,
  description,
  confirmLabel = "Confirm",
  cancelLabel = "Cancel",
  confirmLoadingLabel = "Working...",
  triggerAttribute,
  idAttribute,
  endpoint,
  method = "DELETE",
  payloadKey = "id",
  sendPayload = true,
  errorMessage = "Something went wrong. Please try again.",
  successRedirect
} = Astro.props;
---

<Modal
  id={id}
  title={title}
  data-confirm-dialog="true"
  data-trigger-attribute={triggerAttribute}
  data-id-attribute={idAttribute}
  data-endpoint={endpoint}
  data-method={method}
  data-payload-key={payloadKey}
  data-send-payload={sendPayload ? "true" : "false"}
  data-error-message={errorMessage}
  data-success-redirect={successRedirect}
  data-confirm-loading-label={confirmLoadingLabel}
>
  {description && <p class="text-sm text-text-muted mb-6">{description}</p>}

  <div class="flex gap-3">
    <Button variant="secondary" class="flex-1" data-close-modal>
      {cancelLabel}
    </Button>
    <Button variant="danger" class="flex-1" data-confirm-modal>
      {confirmLabel}
    </Button>
  </div>
</Modal>
