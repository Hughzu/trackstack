---
import { ClientRouter } from "astro:transitions";
import DomainNav from "@/core/ui/DomainNav.astro";
import TopBar from "@/core/ui/TopBar.astro";
import Head from "@/core/layouts/Head.astro";
import ClientRuntime from "@/core/layouts/ClientRuntime.astro";
import ApiFormHandler from "@/core/layouts/ApiFormHandler.astro";
import "@/core/styles/global.css";

type AppDomain = {
  id: string;
  label: string;
  href: string;
};

type AppProfile = {
  initials?: string;
  imageUrl?: string;
  href?: string;
  ariaLabel?: string;
};

interface Props {
  title?: string;
  currentDomain?: string;
  domains: AppDomain[];
  appName: string;
  profile?: AppProfile;
}

const { title, currentDomain, domains, appName, profile } = Astro.props;
const navDomains = domains ?? [];
const resolvedTitle = title ?? appName ?? "";
const resolvedDomain = currentDomain ?? navDomains[0]?.id ?? "home";
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={resolvedTitle} />
    <ClientRouter />
  </head>
  <body
    class="bg-background text-text-main antialiased selection:bg-primary/30"
  >
    <header
      class="sticky top-0 z-50 bg-background/95 backdrop-blur-md
transition-all duration-300 border-b border-transparent transition-border"
    >
      <TopBar appName={appName} profile={profile} />
      <DomainNav current={resolvedDomain} domains={navDomains} />
    </header>
    <main class="max-w-3xl mx-auto px-4 pt-6 animate-fade-in min-h-[60vh]">
      <slot />
    </main>
    <div
      class="fixed inset-x-0 bottom-0 z-50 flex justify-center pointer-events-none px-4"
      style="padding-bottom: calc(3.5rem + env(safe-area-inset-bottom));"
    >
      <div
        class="pointer-events-auto flex gap-3 shadow-xl
rounded-full p-1 bg-surface/5 backdrop-blur-sm"
      >
        <slot name="actions" />
      </div>
    </div>

    <ClientRuntime />
    <ApiFormHandler />
  </body>
</html>
