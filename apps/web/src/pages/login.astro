---
import Layout from "@/layouts/Layout.astro";
import { appConfig } from "@/config/app";
import "@/styles/global.css";
import AuthShell from "@/components/AuthShell.astro";
import Button from "@/components/Button.astro";
---

<Layout title="Sign in">
  <AuthShell appName={appConfig.appName} title="Sign in">
    <form
      method="POST"
      action="/api/auth/login"
      class="flex flex-col gap-6"
      data-api-form
      data-redirect="/"
      data-error-target="login-error"
    >
      <div class="flex flex-col gap-1">
        <label for="email" class="text-xs text-text-muted ml-1"> Email </label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
          class="bg-transparent border-b border-border py-2 text-text-main focus:outline-none focus:border-primary transition-colors"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="password" class="text-xs text-text-muted ml-1">
          Password
        </label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
          class="bg-transparent border-b border-border py-2 text-text-main focus:outline-none focus:border-primary transition-colors"
        />
      </div>

      <Button type="submit" class="w-full">Sign in</Button>
      <p
        id="login-error"
        class="text-xs text-red-200 hidden"
        aria-live="polite"
      >
      </p>
    </form>
  </AuthShell>
</Layout>
