---
import Layout from "@/app/layouts/Layout.astro";
import "@/core/styles/global.css";
import FormShell from "@/core/ui-kit/FormShell.astro";
import FormCard from "@/core/ui-kit/FormCard.astro";
import SectionHeader from "@/core/ui-kit/SectionHeader.astro";
import List from "@/core/ui-kit/List.astro";
import ListRow from "@/core/ui-kit/ListRow.astro";
import IconButton from "@/core/ui-kit/IconButton.astro";
import ConfirmModal from "@/core/ui-kit/ConfirmModal.astro";
import { expensesService } from "@/modules/expenses/services/expensesService";
import { getCurrentUserId } from "@/core/auth/currentUser";

const currentUserId = getCurrentUserId();
const config = await expensesService.getSettings(currentUserId);
const obligations = await expensesService.getChecklistTemplates(currentUserId);
const recurring = await expensesService.getRecurringTemplates(currentUserId);
const ratioTotal = config.ratioFund + config.ratioFun + config.ratioFuture;
const error = Astro.url.searchParams.get("error");

const formatCategory = (category: string) => {
  if (category === "fun") return "Fun";
  if (category === "future") return "Future";
  return "Fund.";
};
---

<Layout>
  <FormShell
    title="Settings"
    cancelHref="/expenses"
    formId="expenses-settings-form"
    class="pb-20"
    action="/api/expenses/settings"
    method="POST"
  >
    {error && (
      <p class="text-xs text-red-200" role="alert">
        Unable to save settings. Check the fields and try again.
      </p>
    )}
    <section class="flex flex-col gap-3">
      <SectionHeader title="Projected Income" size="xs" uppercase />
      <FormCard class="flex items-center justify-between">
        <div class="flex flex-col">
          <span class="text-sm font-medium">Monthly Net</span>
          <span class="text-[10px] text-text-muted">
            Sets the budget denominator
          </span>
        </div>
        <div class="relative w-32">
          <span class="absolute left-0 top-1/2 -translate-y-1/2 text-text-muted"
            >€</span
          >
          <input
            type="number"
            name="income"
            value={config.income}
            class="w-full bg-transparent text-right font-bold text-xl focus:outline-none border-b border-transparent focus:border-primary transition-colors text-text-main placeholder:text-text-muted/30"
          />
        </div>
      </FormCard>
    </section>

    <section class="flex flex-col gap-4">
      <div class="flex justify-between items-end px-1">
        <SectionHeader title="Ratios" size="xs" uppercase />
        <span
          class="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full font-mono"
          data-ratio-total
        >
          Total: {ratioTotal}%
        </span>
      </div>

      <FormCard class="gap-6">
        <div class="space-y-3">
          <div class="flex justify-between text-sm items-center">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-500"></span>
              <span class="font-medium">Fundamentals</span>
            </span>
            <span
              class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border"
              data-ratio-label="fund">{config.ratioFund}%</span
            >
          </div>
          <input
            type="range"
            min="0"
            max="100"
            name="ratioFund"
            value={config.ratioFund}
            class="w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-red-500 hover:accent-red-400 transition-colors"
          />
        </div>

        <div class="space-y-3">
          <div class="flex justify-between text-sm items-center">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-orange-500"></span>
              <span class="font-medium">Fun</span>
            </span>
            <span
              class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border"
              data-ratio-label="fun">{config.ratioFun}%</span
            >
          </div>
          <input
            type="range"
            min="0"
            max="100"
            name="ratioFun"
            value={config.ratioFun}
            class="w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-orange-500 hover:accent-orange-400 transition-colors"
          />
        </div>

        <div class="space-y-3">
          <div class="flex justify-between text-sm items-center">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="font-medium">Future</span>
            </span>
            <span
              class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border"
              data-ratio-label="future">{config.ratioFuture}%</span
            >
          </div>
          <input
            type="range"
            min="0"
            max="100"
            name="ratioFuture"
            value={config.ratioFuture}
            class="w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-500 hover:accent-emerald-400 transition-colors"
          />
        </div>
      </FormCard>
    </section>

    <section class="flex flex-col gap-3">
      <div class="px-1">
        <SectionHeader title="Monthly Checklist" size="xs" uppercase />
        <p class="text-[10px] text-text-muted mt-0.5">
          Recurring payments to check off every month.
        </p>
      </div>

      <List
        data-checklist-list
        isEmpty={obligations.length === 0}
        emptyMessage="All obligations paid for this month!"
      >
        {
          obligations.map((item) => (
            <ListRow>
              <div slot="left" class="font-medium text-sm">
                {item.title}
              </div>
              <div slot="right" class="flex items-center gap-3">
                <span class="text-[10px] uppercase text-text-muted">
                  {formatCategory(item.category)}
                </span>
                <span class="font-mono text-sm text-text-muted">
                  €{item.amount}
                </span>
                <IconButton
                  variant="danger"
                  type="button"
                  data-checklist-delete
                  data-checklist-id={item.id}
                  ariaLabel="Delete checklist item"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-4"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"
                    />
                  </svg>
                </IconButton>
              </div>
            </ListRow>
          ))
        }

        <div
          class="p-3 bg-black/20 grid grid-cols-[1.6fr_0.8fr_0.7fr_auto] gap-3 items-center"
        >
          <input
            form="expense-checklist-form"
            name="title"
            type="text"
            placeholder="Name (e.g. Netflix)"
            class="min-w-0 bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 transition-colors text-text-main"
            required
          />
          <input
            form="expense-checklist-form"
            name="amount"
            type="number"
            step="0.01"
            placeholder="€"
            class="min-w-0 bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 text-right transition-colors text-text-main"
            required
          />
          <select
            form="expense-checklist-form"
            name="category"
            class="min-w-0 bg-surface border border-border rounded-lg px-2 py-1 text-xs text-text-main appearance-none focus:outline-none focus:border-primary"
            required
          >
            <option value="fund">Fund.</option>
            <option value="fun">Fun</option>
            <option value="future">Future</option>
          </select>
          <button
            form="expense-checklist-form"
            type="submit"
            class="text-primary hover:text-primary/80 font-bold text-xs bg-primary/10 px-3 py-1.5 rounded-full border border-primary/20 transition-all"
          >
            Add
          </button>
        </div>
      </List>
    </section>

    <section class="flex flex-col gap-3">
      <div class="px-1">
        <SectionHeader title="Recurring Expenses" size="xs" uppercase />
        <p class="text-[10px] text-text-muted mt-0.5">
          Auto-added to every new sheet.
        </p>
      </div>
      <List
        data-recurring-list
        isEmpty={recurring.length === 0}
        emptyMessage="No recurring expenses yet."
      >
        {
          recurring.map((item) => (
            <ListRow>
              <div slot="left" class="font-medium text-sm">
                {item.title}
              </div>
              <div slot="right" class="flex items-center gap-3">
                <span class="text-[10px] uppercase text-text-muted">
                  {formatCategory(item.category)}
                </span>
                <span class="font-mono text-sm text-text-muted">
                  €{item.amount}
                </span>
                <IconButton
                  variant="danger"
                  type="button"
                  data-recurring-delete
                  data-recurring-id={item.id}
                  ariaLabel="Delete recurring expense"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-4"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"
                    />
                  </svg>
                </IconButton>
              </div>
            </ListRow>
          ))
        }

        <div
          class="p-3 bg-black/20 grid grid-cols-[1.6fr_0.8fr_0.7fr_auto] gap-3 items-center"
        >
          <input
            form="expense-recurring-form"
            name="title"
            type="text"
            placeholder="Name (e.g. Rent)"
            class="min-w-0 bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 transition-colors text-text-main"
            required
          />
          <input
            form="expense-recurring-form"
            name="amount"
            type="number"
            step="0.01"
            placeholder="€"
            class="min-w-0 bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 text-right transition-colors text-text-main"
            required
          />
          <select
            form="expense-recurring-form"
            name="category"
            class="min-w-0 bg-surface border border-border rounded-lg px-2 py-1 text-xs text-text-main appearance-none focus:outline-none focus:border-primary"
            required
          >
            <option value="fund">Fund.</option>
            <option value="fun">Fun</option>
            <option value="future">Future</option>
          </select>
          <button
            form="expense-recurring-form"
            type="submit"
            class="text-primary hover:text-primary/80 font-bold text-xs bg-primary/10 px-3 py-1.5 rounded-full border border-primary/20 transition-all"
          >
            Add
          </button>
        </div>
      </List>
    </section>
  </FormShell>
</Layout>

<form
  id="expense-checklist-form"
  action="/api/expenses/checklist"
  method="POST"
>
</form>
<form
  id="expense-recurring-form"
  action="/api/expenses/recurring"
  method="POST"
>
</form>

<ConfirmModal
  id="expense-checklist-delete-modal"
  title="Delete checklist item?"
  description="This removes the item from your monthly checklist."
  confirmLabel="Delete"
  confirmLoadingLabel="Deleting..."
  triggerAttribute="data-checklist-delete"
  idAttribute="data-checklist-id"
  endpoint="/api/expenses/checklist"
  method="DELETE"
  errorMessage="Unable to delete checklist item."
/>

<ConfirmModal
  id="expense-recurring-delete-modal"
  title="Delete recurring expense?"
  description="This removes the item from future sheets."
  confirmLabel="Delete"
  confirmLoadingLabel="Deleting..."
  triggerAttribute="data-recurring-delete"
  idAttribute="data-recurring-id"
  endpoint="/api/expenses/recurring"
  method="DELETE"
  errorMessage="Unable to delete recurring expense."
/>

<script>
  const form = document.getElementById("expenses-settings-form");
  const ratioTotalEl = document.querySelector("[data-ratio-total]");
  const ratioLabels = {
    fund: document.querySelector('[data-ratio-label="fund"]'),
    fun: document.querySelector('[data-ratio-label="fun"]'),
    future: document.querySelector('[data-ratio-label="future"]'),
  };

  const updateRatios = () => {
    if (!form) return;
    const fundValue = Number(
      (form.querySelector('[name="ratioFund"]') as HTMLInputElement)?.value ||
        0,
    );
    const funValue = Number(
      (form.querySelector('[name="ratioFun"]') as HTMLInputElement)?.value || 0,
    );
    const futureValue = Number(
      (form.querySelector('[name="ratioFuture"]') as HTMLInputElement)?.value ||
        0,
    );
    const total = fundValue + funValue + futureValue;

    if (ratioTotalEl) {
      ratioTotalEl.textContent = `Total: ${total}%`;
    }

    if (ratioLabels.fund) ratioLabels.fund.textContent = `${fundValue}%`;
    if (ratioLabels.fun) ratioLabels.fun.textContent = `${funValue}%`;
    if (ratioLabels.future) ratioLabels.future.textContent = `${futureValue}%`;
  };

  const bindRatioUpdates = () => {
    if (!form) return;
    const inputs = form.querySelectorAll('input[type="range"][name^="ratio"]');
    inputs.forEach((input) => {
      input.addEventListener("input", updateRatios);
      input.addEventListener("change", updateRatios);
    });
  };

  updateRatios();
  bindRatioUpdates();
</script>
