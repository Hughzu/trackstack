---
import AppShell from "@/layouts/AppShell.astro";
import Fab from "@/components/Fab.astro";
import ConfirmModal from "@/components/ConfirmModal.astro";
import ExpensesDashboardClient from "@/modules/expenses/components/ExpensesDashboardClient.astro";
---

<AppShell title="Wealth" currentDomain="expenses">
  <ExpensesDashboardClient />

  <div slot="actions" class="flex gap-2 w-full max-w-sm mx-auto">
    <Fab
      variant="secondary"
      href="/expenses/settings"
      class="flex-1 justify-center"
    >
      <svg
        slot="icon"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-5"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"
        ></path><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path></svg
      >
      Settings
    </Fab>
    <Fab variant="primary" href="/expenses/new" class="flex-2 justify-center">
      <svg
        slot="icon"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-5"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 4.5v15m7.5-7.5h-15"></path></svg
      >
      Add Expense
    </Fab>
  </div>
</AppShell>

<ConfirmModal
  id="expense-delete-modal"
  title="Delete expense?"
  description="This removes the entry from your history. This action cannot be undone."
  confirmLabel="Delete"
  confirmLoadingLabel="Deleting..."
  triggerAttribute="data-expense-delete"
  idAttribute="data-expense-id"
  endpoint="/api/expenses/entries"
  method="DELETE"
  errorMessage="Unable to delete expense."
/>

<ConfirmModal
  id="expense-close-modal"
  title="Close month?"
  description="This closes the current sheet and starts a new one."
  confirmLabel="Close month"
  confirmLoadingLabel="Closing..."
  triggerAttribute="data-expense-close"
  endpoint="/api/expenses/sheet/close"
  method="POST"
  sendPayload={false}
  errorMessage="Unable to close month."
/>
