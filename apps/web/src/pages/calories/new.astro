---
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
import FormShell from "@/components/FormShell.astro";
import FormCard from "@/components/FormCard.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout authMode="required">
  <FormShell
    title="Add Log"
    cancelHref="/calories"
    formId="calorie-form"
    data-api-form
    data-redirect="/calories"
    action="/api/calories/log"
    method="POST"
  >
    {error && (
      <p class="text-xs text-red-200" role="alert">
        Unable to save log. Check the fields and try again.
      </p>
    )}
    <div class="flex flex-col items-center gap-2 mt-4">
      <label
        for="calories"
        class="text-xs text-text-muted uppercase tracking-widest"
        >Calories</label
      >
      <div class="relative w-full max-w-[200px]">
        <input
          type="number"
          id="calories"
          name="calories"
          placeholder="0"
          autofocus
          required
          class="w-full bg-transparent border-b-2 border-border text-center text-5xl font-bold text-text-main focus:outline-none focus:border-primary pb-2 placeholder:text-text-muted/20"
        />
        <span
          class="absolute right-0 top-1/2 -translate-y-1/2 text-sm text-text-muted font-bold translate-x-8"
          >kcal</span
        >
      </div>
    </div>

    <div class="flex flex-col gap-3">
      <label class="text-xs text-text-muted uppercase tracking-widest px-1"
        >Macros (Optional)</label
      >
      <div class="grid grid-cols-3 gap-3">
        <div
          class="bg-surface rounded-2xl p-3 border border-border flex flex-col items-center gap-1"
        >
          <label
            for="protein"
            class="text-[10px] text-emerald-400 uppercase font-bold tracking-wider"
            >Protein</label
          >
          <div class="relative w-full">
            <input
              type="number"
              id="protein"
              name="protein"
              placeholder="0"
              required
              class="w-full bg-transparent text-center font-bold text-xl focus:outline-none text-text-main placeholder:text-text-muted/20"
            />
            <span
              class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-text-muted"
              >g</span
            >
          </div>
        </div>

        <div
          class="bg-surface rounded-2xl p-3 border border-border flex flex-col items-center gap-1"
        >
          <label
            for="carbs"
            class="text-[10px] text-orange-400 uppercase font-bold tracking-wider"
            >Carbs</label
          >
          <div class="relative w-full">
            <input
              type="number"
              id="carbs"
              name="carbs"
              placeholder="0"
              class="w-full bg-transparent text-center font-bold text-xl focus:outline-none text-text-main placeholder:text-text-muted/20"
            />
            <span
              class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-text-muted"
              >g</span
            >
          </div>
        </div>

        <div
          class="bg-surface rounded-2xl p-3 border border-border flex flex-col items-center gap-1"
        >
          <label
            for="fat"
            class="text-[10px] text-yellow-400 uppercase font-bold tracking-wider"
            >Fat</label
          >
          <div class="relative w-full">
            <input
              type="number"
              id="fat"
              name="fat"
              placeholder="0"
              class="w-full bg-transparent text-center font-bold text-xl focus:outline-none text-text-main placeholder:text-text-muted/20"
            />
            <span
              class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-text-muted"
              >g</span
            >
          </div>
        </div>
      </div>
    </div>

    <FormCard>
      <div class="flex flex-col gap-1">
        <label for="title" class="text-xs text-text-muted ml-1">Title</label>
        <input
          type="text"
          id="title"
          name="title"
          placeholder="e.g. Oatmeal & Whey"
          class="bg-transparent border-b border-border py-2 text-text-main focus:outline-none focus:border-primary transition-colors"
        />
      </div>

    </FormCard>
  </FormShell>
</Layout>
