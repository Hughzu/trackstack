---
import Card from "@/core/ui-kit/Card.astro";
import SectionHeader from "@/core/ui-kit/SectionHeader.astro";

interface Props {
  seasonLabel: string;
  seasonToDate: number;
  lastSeasonToDate: number;
}

const { seasonLabel, seasonToDate, lastSeasonToDate } = Astro.props;

const formatNumber = (value: number) =>
  new Intl.NumberFormat("en-US").format(value);
---

<section>
  <SectionHeader
    title="Season Snapshot"
    subtitle={seasonLabel}
    size="xs"
    uppercase
  />
  <div class="grid grid-cols-2 gap-3">
    <Card variant="highlight">
      <div class="flex flex-col items-center justify-center py-2">
        <span class="text-[10px] text-text-muted uppercase tracking-widest mb-1"
          >This season</span
        >
        <span class="text-3xl font-semibold text-text-main tracking-tight"
          >{formatNumber(seasonToDate)}</span
        >
      </div>
    </Card>
    <Card variant="highlight">
      <div class="flex flex-col items-center justify-center py-2">
        <span class="text-[10px] text-text-muted uppercase tracking-widest mb-1"
          >Last season</span
        >
        <span class="text-3xl font-semibold text-text-main tracking-tight"
          >{formatNumber(lastSeasonToDate)}</span
        >
      </div>
    </Card>
  </div>
</section>
