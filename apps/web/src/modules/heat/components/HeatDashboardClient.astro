---
import Skeleton from "@/components/Skeleton.astro";
---

<div class="flex flex-col gap-5 pb-24" data-heat-dashboard>
  <p
    class="hidden rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-100"
    data-heat-error
    role="alert"
  >
    Unable to load heating data right now.
  </p>

  <section>
    <div class="relative overflow-hidden rounded-2xl border border-primary/20 bg-surface p-5 text-text-main shadow-lg shadow-black/40 ring-1 ring-primary/20">
      <div class="absolute right-0 top-0 hidden p-3" data-heat-warning>
        <span class="relative flex h-3 w-3">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-orange-400 opacity-75"></span>
          <span class="relative inline-flex h-3 w-3 rounded-full bg-orange-500"></span>
        </span>
      </div>

      <div class="flex flex-col items-center justify-center py-4">
        <span class="mb-1 text-xs uppercase tracking-widest text-text-muted">Days Since Refill</span>
        <span class="flex h-[60px] items-center" data-heat-days><Skeleton class="h-12 w-20 rounded bg-white/10" /></span>
      </div>
    </div>
  </section>

  <section>
    <div class="mb-2 flex items-center justify-between px-1">
      <span class="text-xs font-bold uppercase tracking-widest text-text-muted">Season Snapshot</span>
      <span class="flex h-4 items-center" data-heat-season-label><Skeleton class="h-3 w-16 rounded bg-white/10" /></span>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div class="rounded-2xl border border-primary/20 bg-surface p-5 text-text-main shadow-lg shadow-black/40 ring-1 ring-primary/20">
        <div class="flex flex-col items-center justify-center py-2">
          <span class="mb-1 text-[10px] uppercase tracking-widest text-text-muted">This season</span>
          <div class="flex h-[40px] items-center" data-heat-current><Skeleton class="h-7 w-16 rounded-lg bg-white/10" /></div>
        </div>
      </div>
      <div class="rounded-2xl border border-primary/20 bg-surface p-5 text-text-main shadow-lg shadow-black/40 ring-1 ring-primary/20">
        <div class="flex flex-col items-center justify-center py-2">
          <span class="mb-1 text-[10px] uppercase tracking-widest text-text-muted">Last season</span>
          <div class="flex h-[40px] items-center" data-heat-last><Skeleton class="h-7 w-16 rounded-lg bg-white/10" /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-4">
    <div class="mb-2 flex items-center justify-between px-1">
      <span class="text-sm font-bold text-text-muted">Refill History</span>
    </div>
    <div class="overflow-hidden rounded-2xl border border-primary/20 bg-panel shadow-lg shadow-black/40 divide-y divide-white/5" data-refill-history>
      <div class="flex items-center justify-between p-3">
        <div class="min-w-0 flex flex-col gap-2">
          <Skeleton class="h-4 w-24 rounded bg-white/10" />
          <Skeleton class="h-3 w-16 rounded bg-white/10" />
        </div>
        <Skeleton class="h-4 w-12 rounded bg-white/10" />
      </div>
      <div class="flex items-center justify-between p-3">
        <div class="min-w-0 flex flex-col gap-2">
          <Skeleton class="h-4 w-32 rounded bg-white/10" />
          <Skeleton class="h-3 w-20 rounded bg-white/10" />
        </div>
        <Skeleton class="h-4 w-16 rounded bg-white/10" />
      </div>
    </div>
  </section>
</div>

<script>
  import { resolveBrowserApiUrl } from "@/config/api";

  const waitForAuthReady = () => {
    if (document.documentElement.dataset.authReady === "true") {
      return Promise.resolve(window.__TRACKSTACK_AUTH__);
    }

    return new Promise((resolve) => {
      const handler = (event) => {
        document.removeEventListener("trackstack:auth-ready", handler);
        resolve(event.detail);
      };
      document.addEventListener("trackstack:auth-ready", handler);
    });
  };

  const formatNumber = (value) => new Intl.NumberFormat("en-US").format(Number(value ?? 0));

  const formatDate = (dateInput) => {
    const date = new Date(dateInput);
    return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
  };

  const createHistoryRow = (item) => {
    const row = document.createElement("div");
    row.className = "group flex items-center justify-between p-3";
    row.innerHTML = `
      <div class="min-w-0">
        <div class="text-sm font-medium text-text-main">${formatDate(item.date)}</div>
        ${item.season ? `<div class="text-[10px] text-text-muted">Season ${item.season}</div>` : ""}
        ${item.temperature !== undefined && item.temperature !== null ? `<div class="text-[10px] text-text-muted">Avg Temp: ${item.temperature}degC</div>` : ""}
      </div>
      <div class="flex items-center gap-2">
        <div class="text-sm font-mono text-text-main">${item.bags} Bag${item.bags !== 1 ? "s" : ""}</div>
      </div>
    `;

    const button = document.createElement("button");
    button.type = "button";
    button.className = "h-10 w-10 rounded-full text-gray-600 transition-colors hover:text-red-500 active:bg-red-500/10";
    button.setAttribute("aria-label", "Delete refill");
    button.setAttribute("data-refill-delete", "");
    button.setAttribute("data-refill-id", item.id);
    button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>';
    row.lastElementChild.appendChild(button);
    return row;
  };

  const renderHistory = (history) => {
    const list = document.querySelector("[data-refill-history]");
    if (!list) return;

    list.innerHTML = "";
    if (!history.length) {
      list.innerHTML = '<div class="p-4 text-center text-xs italic text-text-muted">No refill history found.</div>';
      return;
    }

    history.forEach((item) => list.appendChild(createHistoryRow(item)));
  };

  const showError = () => {
    const error = document.querySelector("[data-heat-error]");
    if (error) error.classList.remove("hidden");
  };

  const renderDashboard = (viewModel) => {
    document.querySelector("[data-heat-days]").innerHTML = String(viewModel.daysSinceRefill);
    document.querySelector("[data-heat-days]").className = "text-6xl font-bold tracking-tighter text-text-main";
    document.querySelector("[data-heat-season-label]").textContent = viewModel.seasonSnapshot.seasonLabel;
    document.querySelector("[data-heat-season-label]").className = "text-[11px] text-text-muted";
    document.querySelector("[data-heat-current]").innerHTML = `<span class="text-2xl font-bold">${formatNumber(viewModel.seasonSnapshot.seasonToDate)}</span><span class="ml-1 text-xs text-text-muted">bags</span>`;
    document.querySelector("[data-heat-last]").innerHTML = `<span class="text-2xl font-bold text-text-muted">${formatNumber(viewModel.seasonSnapshot.lastSeasonToDate)}</span><span class="ml-1 text-xs text-text-muted">bags</span>`;
    document.querySelector("[data-heat-warning]").classList.toggle("hidden", !(viewModel.daysSinceRefill > 14));
    renderHistory(viewModel.history ?? []);
  };

  const loadDashboard = async () => {
    const root = document.querySelector("[data-heat-dashboard]") as HTMLElement | null;
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const auth = await waitForAuthReady();
    if (!auth?.authenticated) return;

    try {
      const token = window.localStorage.getItem("trackstack_token");
      const headers: Record<string, string> = {};
      if (token) headers["Authorization"] = `Bearer ${token}`;

      const response = await fetch(resolveBrowserApiUrl("/api/heat/dashboard?page=1&limit=20"), {
        headers,
      });

      if (response.status === 401) {
        window.location.replace("/login");
        return;
      }

      if (!response.ok) {
        showError();
        return;
      }

      const viewModel = await response.json();
      renderDashboard(viewModel);
    } catch {
      showError();
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadDashboard, { once: true });
  } else {
    loadDashboard();
  }

  document.addEventListener("astro:page-load", loadDashboard);
</script>
