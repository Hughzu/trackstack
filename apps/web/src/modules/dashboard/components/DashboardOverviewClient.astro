---
import Skeleton from "@/components/Skeleton.astro";
---

<div class="flex flex-col gap-5 pb-24" data-dashboard-overview>
  <p
    class="hidden rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-100"
    data-dashboard-error
    role="alert"
  >
    Unable to load your dashboard right now.
  </p>

  <a
    href="/expenses"
    class="relative flex flex-col overflow-hidden rounded-2xl border border-primary/20 bg-surface p-5 text-text-main shadow-lg shadow-black/40 ring-1 ring-primary/20"
    data-dashboard-card="expenses"
  >
    <div class="mb-4">
      <h3 class="text-xs font-bold uppercase tracking-widest text-primary">Expenses</h3>
    </div>
    <div class="flex justify-between items-start mb-4">
      <div class="mb-4 text-center">
        <div class="text-xs uppercase tracking-widest text-text-muted">Remaining</div>
        <div class="flex justify-center h-9 items-center" data-expenses-remaining><Skeleton class="h-8 w-24 rounded bg-white/10" /></div>
      </div>
      <div class="text-right">
        <span class="text-xs uppercase tracking-widest text-text-muted">Income</span>
        <div class="text-sm font-mono text-text-muted" data-expenses-income>--</div>
      </div>
    </div>
    <div class="mb-2 flex h-2 overflow-hidden rounded-full bg-gray-800" data-expenses-bar></div>
    <div class="mb-3 flex justify-between text-[10px] font-mono text-text-muted" data-expenses-ratios></div>
    <div class="flex justify-between text-center divide-x divide-white/10">
      <div class="flex-1 px-1">
        <div class="text-[10px] uppercase text-text-muted">Fund.</div>
        <div class="text-xs font-bold" data-expenses-fund-spent>--</div>
        <div class="text-[10px] text-text-muted" data-expenses-fund-budget>--</div>
      </div>
      <div class="flex-1 px-1">
        <div class="text-[10px] uppercase text-text-muted">Fun</div>
        <div class="text-xs font-bold" data-expenses-fun-spent>--</div>
        <div class="text-[10px] text-text-muted" data-expenses-fun-budget>--</div>
      </div>
      <div class="flex-1 px-1">
        <div class="text-[10px] uppercase text-text-muted">Future</div>
        <div class="text-xs font-bold" data-expenses-future-spent>--</div>
        <div class="text-[10px] text-text-muted" data-expenses-future-budget>--</div>
      </div>
    </div>
  </a>

  <a
    href="/calories"
    class="relative flex flex-col overflow-hidden rounded-2xl border border-primary/20 bg-surface p-5 text-text-main shadow-lg shadow-black/40 ring-1 ring-primary/20"
    data-dashboard-card="calories"
  >
    <div class="mb-4">
      <h3 class="text-xs font-bold uppercase tracking-widest text-primary">Daily Intake</h3>
    </div>
    <div class="flex justify-between items-start mb-4">
      <div>
        <span class="text-xs uppercase tracking-widest text-text-muted">Consumed</span>
        <div class="flex items-center gap-3">
          <div class="flex justify-center h-9 items-center" data-calories-consumed><Skeleton class="h-8 w-16 rounded bg-white/10" /></div>
          <span class="text-xs text-text-muted" data-calories-target>/ --</span>
        </div>
      </div>
      <div class="text-right">
        <span class="text-xs uppercase tracking-widest text-text-muted">Protein</span>
        <div class="text-sm font-bold text-primary" data-calories-protein>--</div>
      </div>
    </div>
    <div class="mb-1 h-2 overflow-hidden rounded-full bg-gray-800">
      <div class="h-full bg-primary transition-all duration-300" data-calories-bar style="width: 0%"></div>
    </div>
  </a>

  <a
    href="/heat"
    class="relative flex flex-col overflow-hidden rounded-2xl border border-primary/20 bg-surface p-5 text-text-main shadow-lg shadow-black/40 ring-1 ring-primary/20"
    data-dashboard-card="heat"
  >
    <div class="mb-4">
      <h3 class="text-xs font-bold uppercase tracking-widest text-primary">Heating</h3>
    </div>
    <div class="flex items-center justify-between">
      <div class="mb-4 flex items-center justify-between">
        <div class="flex justify-center h-9 items-center" data-heat-days><Skeleton class="h-8 w-16 rounded bg-white/10" /></div>
        <div class="text-right">
          <div class="text-[10px] uppercase text-text-muted">Avg/Day</div>
        </div>
      </div>
      <div class="text-right">
        <span class="text-xs uppercase tracking-widest text-text-muted">Season</span>
        <div class="text-sm font-mono text-text-muted" data-heat-season-label>--</div>
      </div>
    </div>
    <div class="mt-4 flex justify-between text-xs text-text-muted">
      <span>
        This Season:
        <span class="font-semibold text-text-main" data-heat-season-current>--</span>
      </span>
      <span>
        Last Season:
        <span class="font-semibold text-text-main" data-heat-season-last>--</span>
      </span>
    </div>
  </a>
</div>

<script>
  import { resolveBrowserApiUrl } from "@/config/api";

  type RatioSegment = {
    categoryId: string;
    percent: number;
    label?: string;
    over?: boolean;
  };

  type ExpensesDashboard = {
    balance: { remaining: number; income: number };
    ratios: RatioSegment[];
    spent: { fund: number; fun: number; future: number };
    budget: { fund: number; fun: number; future: number };
  };

  type CaloriesDashboard = {
    summary: {
      consumed: number;
      protein: number;
      target: {
        targetKcal: number;
        targetProteinG: number;
      };
    };
  };

  type HeatSeason = {
    seasonLabel?: string;
    label?: string;
    seasonToDate?: number;
    current?: number;
    lastSeasonToDate?: number;
    last?: number;
  };

  type HeatDashboard = {
    daysSinceRefill: number;
    seasonSnapshot?: HeatSeason;
    season?: HeatSeason;
  };

  type AuthState = {
    authenticated?: boolean;
  };

  const euroFormatter = new Intl.NumberFormat("en-IE", {
    style: "currency",
    currency: "EUR",
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  const formatEuro = (value: number | string | null | undefined) => euroFormatter.format(Number(value ?? 0));

  const query = <T extends HTMLElement>(selector: string) => document.querySelector(selector) as T | null;

  const setText = (selector: string, value: string) => {
	const element = query<HTMLElement>(selector);
	if (element) {
		element.textContent = value;
	}
  };

  const renderSegments = (container: HTMLElement | null, segments: RatioSegment[]) => {
    if (!container) return;
    container.innerHTML = "";
    
    const getBgColorClass = (categoryId: string) => {
      if (categoryId === 'fun') return 'bg-orange-500';
      if (categoryId === 'future') return 'bg-emerald-500';
      return 'bg-red-500';
    };

    segments.forEach((segment: RatioSegment) => {
      const bar = document.createElement("div");
      bar.className = `${getBgColorClass(segment.categoryId)} h-full transition-all duration-1000 ease-out`;
      bar.style.width = `${segment.percent}%`;
      container.appendChild(bar);
    });
  };

  const renderRatioLabels = (container: HTMLElement | null, segments: RatioSegment[]) => {
    if (!container) return;
    container.innerHTML = "";

    segments
      .filter((segment: RatioSegment) => segment.label)
      .forEach((segment: RatioSegment) => {
        const label = document.createElement("span");
        label.className = segment.over ? "font-semibold text-red-400" : "text-text-muted";
        label.textContent = `${segment.label} ${segment.percent}%`;
        container.appendChild(label);
      });
  };

  const renderExpenses = (dashboard: ExpensesDashboard) => {
    setText("[data-expenses-remaining]", formatEuro(dashboard.balance.remaining));
    setText("[data-expenses-income]", formatEuro(dashboard.balance.income));
    renderSegments(query<HTMLElement>("[data-expenses-bar]"), dashboard.ratios);
    renderRatioLabels(query<HTMLElement>("[data-expenses-ratios]"), dashboard.ratios);
    setText("[data-expenses-fund-spent]", formatEuro(dashboard.spent.fund));
    setText("[data-expenses-fund-budget]", `/ ${formatEuro(dashboard.budget.fund)}`);
    setText("[data-expenses-fun-spent]", formatEuro(dashboard.spent.fun));
    setText("[data-expenses-fun-budget]", `/ ${formatEuro(dashboard.budget.fun)}`);
    setText("[data-expenses-future-spent]", formatEuro(dashboard.spent.future));
    setText("[data-expenses-future-budget]", `/ ${formatEuro(dashboard.budget.future)}`);
  };

  const renderCalories = (dashboard: CaloriesDashboard) => {
    setText("[data-calories-consumed]", String(dashboard.summary.consumed));
    setText("[data-calories-target]", `/ ${dashboard.summary.target.targetKcal} kcal`);
    const protein = query<HTMLElement>("[data-calories-protein]");
    if (protein) {
      protein.innerHTML = `${dashboard.summary.protein}g <span class="font-normal text-text-muted">/ ${dashboard.summary.target.targetProteinG}g</span>`;
    }
    const percent = dashboard.summary.target.targetKcal
      ? Math.min((dashboard.summary.consumed / dashboard.summary.target.targetKcal) * 100, 100)
      : 0;
    const bar = query<HTMLElement>("[data-calories-bar]");
    if (bar) {
      bar.style.width = `${percent}%`;
    }
  };

  const renderHeat = (dashboard: HeatDashboard) => {
    const season = dashboard.seasonSnapshot ?? dashboard.season;
    setText("[data-heat-days]", String(dashboard.daysSinceRefill));
    setText("[data-heat-season-label]", season?.seasonLabel ?? season?.label ?? "--");
    setText("[data-heat-season-current]", String(season?.seasonToDate ?? season?.current ?? "--"));
    setText("[data-heat-season-last]", String(season?.lastSeasonToDate ?? season?.last ?? "--"));
  };

  const showError = () => {
    const error = document.querySelector("[data-dashboard-error]");
    if (error) {
      error.classList.remove("hidden");
    }
  };

  const hideError = () => {
    const error = document.querySelector("[data-dashboard-error]");
    if (error) {
      error.classList.add("hidden");
    }
  };

  const fetchDashboardSection = async <T,>(path: string): Promise<T> => {
    const response = await fetch(resolveBrowserApiUrl(path), {
      credentials: "include",
    });

    if (response.status === 401) {
      window.location.replace("/login");
      throw new Error("unauthorized");
    }

    if (!response.ok) {
      throw new Error(`request failed: ${path}`);
    }

    return response.json() as Promise<T>;
  };

  const waitForAuthReady = (): Promise<AuthState | undefined> => {
    if (document.documentElement.dataset.authReady === "true") {
      return Promise.resolve(window.__TRACKSTACK_AUTH__ as AuthState | undefined);
    }

    return new Promise((resolve: (value: AuthState | undefined) => void) => {
      const handler = (event: Event) => {
        document.removeEventListener("trackstack:auth-ready", handler);
        resolve((event as CustomEvent<AuthState>).detail);
      };
      document.addEventListener("trackstack:auth-ready", handler);
    });
  };

  const loadDashboard = async () => {
    const root = document.querySelector("[data-dashboard-overview]") as HTMLElement | null;
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const auth = await waitForAuthReady();
    if (!auth?.authenticated) {
      return;
    }

    let succeeded = 0;

    const loadSection = async <T,>(path: string, render: (data: T) => void) => {
      const data = await fetchDashboardSection<T>(path);
      render(data);
      succeeded += 1;
      hideError();
    };

    const results = await Promise.allSettled([
      loadSection("/api/expenses/sheet/current", renderExpenses),
      loadSection("/api/calories/dashboard?recentLimit=8", renderCalories),
      loadSection("/api/heat/dashboard?page=1&limit=20", renderHeat),
    ]);

    if (succeeded === 0 && results.some((result) => result.status === "rejected")) {
      showError();
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadDashboard, { once: true });
  } else {
    loadDashboard();
  }

  document.addEventListener("astro:page-load", loadDashboard);
</script>
