---
import Skeleton from "@/components/Skeleton.astro";
---

<div class="flex flex-col gap-5 pb-24" data-calories-dashboard>
  <p
    class="hidden rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-100"
    data-calories-error
    role="alert"
  >
    Unable to load calorie data right now.
  </p>

  <section>
    <div class="relative flex flex-col overflow-hidden rounded-2xl border border-primary/20 bg-surface p-5 text-text-main shadow-lg shadow-black/40 ring-1 ring-primary/20">
      <div class="mb-6 flex items-start justify-between">
        <div>
          <span class="text-xs uppercase tracking-widest text-text-muted">Daily Intake</span>
          <div class="flex flex-col">
            <div class="flex h-9 items-center" data-calories-consumed><Skeleton class="h-8 w-24 rounded bg-white/10" /></div>
            <span class="flex items-center gap-1 mt-1 text-xs font-medium text-text-muted">
              / <span class="flex h-4 items-center" data-calories-target><Skeleton class="h-3 w-8 rounded bg-white/10" /></span> kcal
            </span>
          </div>
        </div>
        <div class="text-right">
          <span class="text-xs uppercase tracking-widest text-text-muted">Protein</span>
          <div class="flex h-5 items-center justify-end font-bold text-primary" data-calories-protein><Skeleton class="h-4 w-12 rounded bg-primary/20" /></div>
        </div>
      </div>

      <div class="mb-6 h-2 overflow-hidden rounded-full bg-gray-800">
        <div class="h-full bg-primary transition-all duration-300" data-calories-progress style="width: 0%"></div>
      </div>

      <div class="grid grid-cols-3 gap-2 text-center divide-x divide-white/10">
        <div class="px-1 mt-1">
          <div class="text-[10px] uppercase text-text-muted">Carbs</div>
          <div class="flex h-4 items-center justify-center font-bold mt-0.5" data-calories-carbs><Skeleton class="h-3 w-8 rounded bg-white/10" /></div>
          <div class="mt-1 h-1 w-full rounded-full bg-orange-400 opacity-50"></div>
        </div>
        <div class="px-1 mt-1">
          <div class="text-[10px] uppercase text-text-muted">Fat</div>
          <div class="flex h-4 items-center justify-center font-bold mt-0.5" data-calories-fat><Skeleton class="h-3 w-8 rounded bg-white/10" /></div>
          <div class="mt-1 h-1 w-full rounded-full bg-yellow-400 opacity-50"></div>
        </div>
        <div class="px-1 mt-1">
          <div class="text-[10px] uppercase text-text-muted">Protein</div>
          <div class="flex h-4 items-center justify-center font-bold mt-0.5" data-calories-protein-summary><Skeleton class="h-3 w-8 rounded bg-white/10" /></div>
          <div class="mt-1 h-1 w-full rounded-full bg-emerald-400 opacity-50"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-4">
    <div class="mb-2 flex items-center justify-between px-1">
      <span class="text-sm font-bold text-text-muted">Quick Add</span>
    </div>
    <div class="quick-add-scroll relative overflow-x-auto pb-2" data-calorie-quick-add>
      <div class="flex min-w-max gap-2 px-1 pb-0 pt-1" data-calorie-quick-add-list>
        <div class="flex min-w-[8rem] h-[38px] items-center justify-center rounded-full border border-primary/20 bg-surface px-4 py-2"><Skeleton class="h-4 w-16 rounded bg-white/10" /></div>
        <div class="flex min-w-[8rem] h-[38px] items-center justify-center rounded-full border border-primary/20 bg-surface px-4 py-2"><Skeleton class="h-4 w-20 rounded bg-white/10" /></div>
        <div class="flex min-w-[8rem] h-[38px] items-center justify-center rounded-full border border-primary/20 bg-surface px-4 py-2"><Skeleton class="h-4 w-12 rounded bg-white/10" /></div>
      </div>
      <div class="hidden py-4 text-center text-xs italic text-text-muted" data-calorie-quick-add-empty>
        No recent meals yet.
      </div>
    </div>
  </section>

  <section class="mt-4">
    <div class="mb-2 flex items-center justify-between px-1">
      <span class="text-sm font-bold text-text-muted">Today's Logs</span>
    </div>
    <div class="overflow-hidden rounded-2xl border border-primary/20 bg-panel shadow-lg shadow-black/40 divide-y divide-white/5" data-calorie-logs-list>
      <div class="flex items-center justify-between p-3">
        <div class="min-w-0 flex flex-col gap-2">
          <Skeleton class="h-4 w-24 rounded bg-white/10" />
          <Skeleton class="h-3 w-16 rounded bg-white/10" />
        </div>
        <Skeleton class="h-4 w-8 rounded bg-white/10" />
      </div>
      <div class="flex items-center justify-between p-3">
        <div class="min-w-0 flex flex-col gap-2">
          <Skeleton class="h-4 w-32 rounded bg-white/10" />
          <Skeleton class="h-3 w-20 rounded bg-white/10" />
        </div>
        <Skeleton class="h-4 w-10 rounded bg-white/10" />
      </div>
    </div>
  </section>
</div>

<style>
  .quick-add-scroll::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { resolveBrowserApiUrl } from "@/config/api";

  const waitForAuthReady = () => {
    if (document.documentElement.dataset.authReady === "true") {
      return Promise.resolve(window.__TRACKSTACK_AUTH__);
    }

    return new Promise((resolve) => {
      const handler = (event) => {
        document.removeEventListener("trackstack:auth-ready", handler);
        resolve(event.detail);
      };
      document.addEventListener("trackstack:auth-ready", handler);
    });
  };

  const formatTime = (dateInput) => {
    const date = new Date(dateInput);
    return date.toLocaleTimeString("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
    });
  };

  const showError = () => {
    const error = document.querySelector("[data-calories-error]");
    if (error) {
      error.classList.remove("hidden");
    }
  };

  const renderSummary = (summary) => {
    document.querySelector("[data-calories-consumed]").textContent = String(summary.consumed);
    document.querySelector("[data-calories-target]").textContent = String(summary.target.targetKcal);
    document.querySelector("[data-calories-protein]").innerHTML = `${summary.protein}g <span class="font-normal text-text-muted">/ ${summary.target.targetProteinG}g</span>`;
    document.querySelector("[data-calories-carbs]").textContent = `${summary.carbs}g`;
    document.querySelector("[data-calories-fat]").textContent = `${summary.fat}g`;
    document.querySelector("[data-calories-protein-summary]").textContent = `${summary.protein}g`;

    const percent = summary.target.targetKcal
      ? Math.min((summary.consumed / summary.target.targetKcal) * 100, 100)
      : 0;
    document.querySelector("[data-calories-progress]").style.width = `${percent}%`;
  };

  const createQuickAddForm = (meal) => {
    const form = document.createElement("form");
    form.setAttribute("data-api-form", "");
    form.setAttribute("action", "/api/calories/log");
    form.setAttribute("method", "POST");

    const hiddenFields = {
      title: meal.title ?? "",
      calories: meal.calories,
      protein: meal.proteinG,
      carbs: meal.carbsG ?? 0,
      fat: meal.fatG ?? 0,
    };

    Object.entries(hiddenFields).forEach(([name, value]) => {
      if (name === "title" && !value) return;
      const input = document.createElement("input");
      input.type = "hidden";
      input.name = name;
      input.value = String(value);
      form.appendChild(input);
    });

    const button = document.createElement("button");
    button.type = "submit";
    button.className = "flex min-w-[8rem] items-center justify-center rounded-full border border-primary/20 bg-surface px-4 py-2 text-sm text-text-main transition-colors hover:border-primary/50 hover:text-primary";
    button.setAttribute("aria-label", `Quick add ${meal.title ?? "meal"}`);
    button.textContent = meal.title ?? "Untitled";
    form.appendChild(button);

    return form;
  };

  const renderQuickAdd = (recentMeals) => {
    const list = document.querySelector("[data-calorie-quick-add-list]");
    const empty = document.querySelector("[data-calorie-quick-add-empty]");
    if (!list || !empty) return;

    list.innerHTML = "";
    if (!recentMeals.length) {
      empty.classList.remove("hidden");
      return;
    }

    empty.classList.add("hidden");
    recentMeals.forEach((meal) => list.appendChild(createQuickAddForm(meal)));
  };

  const createDeleteButton = (id) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "h-10 w-10 rounded-full text-gray-600 transition-colors hover:text-red-500 active:bg-red-500/10";
    button.setAttribute("aria-label", "Delete log");
    button.setAttribute("data-calorie-delete", "");
    button.setAttribute("data-calorie-id", String(id));
    button.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>`;
    return button;
  };

  const createLogRow = (log) => {
    const row = document.createElement("div");
    row.className = "group flex items-center justify-between p-3";
    row.innerHTML = `
      <div class="min-w-0">
        <div class="text-sm font-medium text-text-main">${log.title ?? "Untitled"}</div>
        <div class="flex gap-2 text-[10px] text-text-muted">
          <span>${formatTime(log.dateTime)}</span>
          <span class="text-primary">${log.proteinG}g prot</span>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-sm font-mono text-text-main">${log.calories}</span>
      </div>
    `;
    row.lastElementChild.appendChild(createDeleteButton(log.id));
    return row;
  };

  const renderLogs = (logs) => {
    const list = document.querySelector("[data-calorie-logs-list]");
    if (!list) return;

    list.innerHTML = "";
    if (!logs.length) {
      const empty = document.createElement("div");
      empty.className = "p-4 text-center text-xs italic text-text-muted";
      empty.textContent = "No logs yet for today.";
      list.appendChild(empty);
      return;
    }

    logs.forEach((log) => list.appendChild(createLogRow(log)));
  };

  const renderDashboard = (viewModel) => {
    renderSummary(viewModel.summary);
    renderQuickAdd(viewModel.recentMeals ?? []);
    renderLogs(viewModel.logs ?? []);
    document.dispatchEvent(new CustomEvent("trackstack:bind-api-forms"));
  };

  const loadDashboard = async () => {
    const root = document.querySelector("[data-calories-dashboard]") as HTMLElement | null;
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const auth = await waitForAuthReady();
    if (!auth?.authenticated) {
      return;
    }

    try {
      const response = await fetch(resolveBrowserApiUrl("/api/calories/dashboard?recentLimit=8"), {
        credentials: "include",
      });

      if (response.status === 401) {
        window.location.replace("/login");
        return;
      }

      if (!response.ok) {
        showError();
        return;
      }

      const viewModel = await response.json();
      renderDashboard(viewModel);
    } catch {
      showError();
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadDashboard, { once: true });
  } else {
    loadDashboard();
  }

  document.addEventListener("astro:page-load", loadDashboard);
</script>
