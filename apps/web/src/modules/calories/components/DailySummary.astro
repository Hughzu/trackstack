---
import Card from "@/components/Card.astro";
import PercentageBar from "@/components/PercentageBar.astro";

interface Props {
  summary: {
    consumedCalories: number;
    proteinGrams: number;
    carbGrams: number;
    fatGrams: number;
    target: {
      targetCalories: number;
      targetProteinGrams: number;
    };
  };
}

const { summary } = Astro.props;

const percent = summary.target.targetCalories
  ? Math.min((summary.consumedCalories / summary.target.targetCalories) * 100, 100)
  : 0;

const macroTotal = summary.carbGrams + summary.fatGrams + summary.proteinGrams;
const macros = [
  {
    label: "Carbs",
    amount: `${summary.carbGrams}g`,
    percent: macroTotal ? Math.round((summary.carbGrams / macroTotal) * 100) : 0,
    color: "bg-orange-400",
  },
  {
    label: "Fat",
    amount: `${summary.fatGrams}g`,
    percent: macroTotal ? Math.round((summary.fatGrams / macroTotal) * 100) : 0,
    color: "bg-yellow-400",
  },
  {
    label: "Protein",
    amount: `${summary.proteinGrams}g`,
    percent: macroTotal
      ? Math.round((summary.proteinGrams / macroTotal) * 100)
      : 0,
    color: "bg-emerald-400",
  },
];
---

<Card variant="highlight">
  <div class="flex justify-between items-start mb-6">
    <div>
      <span class="text-xs text-text-muted uppercase tracking-widest">
        Daily Intake
      </span>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-text-main">
          {summary.consumedCalories}
        </span>
        <span class="text-sm font-mono text-text-muted">
          / {summary.target.targetCalories} kcal
        </span>
      </div>
    </div>
    <div class="text-right">
      <span class="text-xs text-text-muted uppercase tracking-widest">
        Protein
      </span>
      <div class="text-sm font-bold text-primary">
        {summary.proteinGrams}g
        <span class="text-text-muted font-normal">
          / {summary.target.targetProteinGrams}g
        </span>
      </div>
    </div>
  </div>

  <div class="mb-6">
    <PercentageBar segments={[{ percent, color: "bg-primary" }]} />
  </div>

  <div class="grid grid-cols-3 gap-2 text-center divide-x divide-white/10">
    {
      macros.map((m) => (
        <div class="px-1">
          <div class="text-[10px] text-text-muted uppercase">{m.label}</div>
          <div class="text-xs font-bold">{m.amount}</div>
          <div class={`h-1 w-full rounded-full mt-1 ${m.color} opacity-50`} />
        </div>
      ))
    }
  </div>
</Card>
