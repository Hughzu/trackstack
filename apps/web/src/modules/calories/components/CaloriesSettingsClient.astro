---
import FormShell from "@/components/FormShell.astro";
import FormCard from "@/components/FormCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
---

<FormShell
  title="Calories Settings"
  cancelHref="/calories"
  formId="calorie-target-form"
  class="pb-20"
  data-api-form
  data-redirect="/calories"
  data-error-target="calories-settings-error"
  action="/api/calories/target"
  method="POST"
>
  <p id="calories-settings-error" class="hidden text-xs text-red-200" role="alert">
    Unable to save settings. Check the fields and try again.
  </p>

  <FormCard class="flex items-center justify-between">
    <div class="flex flex-col">
      <span class="text-sm font-medium">Calories</span>
      <span class="text-[10px] text-text-muted">Sets your daily intake target</span>
    </div>
    <div class="relative w-28">
      <label>
        <input
          type="number"
          name="targetKcal"
          min="0"
          required
          data-calories-target-kcal-input
          class="w-full bg-transparent text-right font-bold text-xl focus:outline-none border-b border-transparent focus:border-primary transition-colors text-text-main placeholder:text-text-muted/30"
        />
      </label>
      <span class="absolute right-0 top-1/2 -translate-y-1/2 text-xs text-text-muted">kcal</span>
    </div>
  </FormCard>

  <section class="flex flex-col gap-4">
    <div class="flex justify-between items-end px-1">
      <SectionHeader title="Macros" size="xs" uppercase />
      <span class="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full font-mono">
        Protein required
      </span>
    </div>

    <FormCard class="gap-6">
      <div class="space-y-3">
        <div class="flex justify-between text-sm items-center">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="font-medium">Protein</span>
          </span>
          <span class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border" data-calories-target-protein-label>
            0g
          </span>
        </div>
        <label>
          <input
            type="number"
            name="targetProtein"
            min="0"
            required
            data-calories-target-protein-input
            class="w-full bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-2 text-text-main placeholder:text-text-muted/30 transition-colors"
          />
        </label>
      </div>

      <div class="space-y-3">
        <div class="flex justify-between text-sm items-center">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-orange-400"></span>
            <span class="font-medium">Carbs</span>
          </span>
          <span class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border" data-calories-target-carbs-label>
            0g
          </span>
        </div>
        <label>
          <input
            type="number"
            name="targetCarbs"
            min="0"
            placeholder="Optional"
            data-calories-target-carbs-input
            class="w-full bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-2 text-text-main placeholder:text-text-muted/30 transition-colors"
          />
        </label>
      </div>

      <div class="space-y-3">
        <div class="flex justify-between text-sm items-center">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
            <span class="font-medium">Fat</span>
          </span>
          <span class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border" data-calories-target-fat-label>
            0g
          </span>
        </div>
        <label>
          <input
            type="number"
            name="targetFat"
            min="0"
            placeholder="Optional"
            data-calories-target-fat-input
            class="w-full bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-2 text-text-main placeholder:text-text-muted/30 transition-colors"
          />
        </label>
      </div>
    </FormCard>
  </section>
</FormShell>

<script>
  import { resolveBrowserApiUrl } from "@/config/api";

  const waitForAuthReady = () => {
    if (document.documentElement.dataset.authReady === "true") {
      return Promise.resolve(window.__TRACKSTACK_AUTH__);
    }

    return new Promise((resolve) => {
      const handler = (event) => {
        document.removeEventListener("trackstack:auth-ready", handler);
        resolve(event.detail);
      };
      document.addEventListener("trackstack:auth-ready", handler);
    });
  };

  const inputRefs = {
    kcal: () => document.querySelector("[data-calories-target-kcal-input]"),
    protein: () => document.querySelector("[data-calories-target-protein-input]"),
    carbs: () => document.querySelector("[data-calories-target-carbs-input]"),
    fat: () => document.querySelector("[data-calories-target-fat-input]"),
  };

  const labelRefs = {
    protein: () => document.querySelector("[data-calories-target-protein-label]"),
    carbs: () => document.querySelector("[data-calories-target-carbs-label]"),
    fat: () => document.querySelector("[data-calories-target-fat-label]"),
  };

  const updateMacroLabels = () => {
    const proteinValue = inputRefs.protein()?.value || "0";
    const carbsValue = inputRefs.carbs()?.value || "0";
    const fatValue = inputRefs.fat()?.value || "0";

    if (labelRefs.protein()) labelRefs.protein().textContent = `${proteinValue}g`;
    if (labelRefs.carbs()) labelRefs.carbs().textContent = `${carbsValue}g`;
    if (labelRefs.fat()) labelRefs.fat().textContent = `${fatValue}g`;
  };

  const bindInputs = () => {
    const form = document.getElementById("calorie-target-form");
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    [inputRefs.protein(), inputRefs.carbs(), inputRefs.fat()].forEach((input) => {
      input?.addEventListener("input", updateMacroLabels);
      input?.addEventListener("change", updateMacroLabels);
    });
  };

  const loadSettings = async () => {
    const auth = await waitForAuthReady();
    if (!auth?.authenticated) return;

    try {
      const response = await fetch(resolveBrowserApiUrl("/api/calories/target"), {
        credentials: "include",
      });

      if (response.status === 401) {
        window.location.replace("/login");
        return;
      }

      if (!response.ok) return;

      const target = await response.json();
      if (inputRefs.kcal()) inputRefs.kcal().value = String(target.targetKcal ?? "");
      if (inputRefs.protein()) inputRefs.protein().value = String(target.targetProteinG ?? "");
      if (inputRefs.carbs()) inputRefs.carbs().value = target.targetCarbsG == null ? "" : String(target.targetCarbsG);
      if (inputRefs.fat()) inputRefs.fat().value = target.targetFatG == null ? "" : String(target.targetFatG);
      updateMacroLabels();
    } catch {
      // Leave empty defaults in place.
    }
  };

  const init = () => {
    bindInputs();
    updateMacroLabels();
    loadSettings();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }

  document.addEventListener("astro:page-load", init);
</script>
