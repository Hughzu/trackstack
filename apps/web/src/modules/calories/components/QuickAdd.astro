---
import SectionHeader from "@/components/SectionHeader.astro";
import PillButton from "@/components/PillButton.astro";

interface Props {
  recentMeals: {
    title?: string;
    calories: number;
    proteinGrams: number;
    carbGrams?: number;
    fatGrams?: number;
  }[];
}

const recentMeals = Astro.props.recentMeals ?? [];
---

<section class="mt-4">
  <SectionHeader title="Quick Add" />
  <div
    class="relative overflow-x-auto pb-2 quick-add-scroll"
    data-calorie-quick-add
    style="scrollbar-width: none; -ms-overflow-style: none;"
  >
    <div class="flex gap-2 min-w-max pt-1 pb-0 px-1">
      {
        recentMeals.map((meal) => (
          <form data-api-form action="/api/calories/log" method="POST">
            {meal.title && (
              <input type="hidden" name="title" value={meal.title} />
            )}
            <input type="hidden" name="calories" value={meal.calories} />
            <input type="hidden" name="proteinGrams" value={meal.proteinGrams} />
            <input type="hidden" name="carbGrams" value={meal.carbGrams ?? 0} />
            <input type="hidden" name="fatGrams" value={meal.fatGrams ?? 0} />
            <PillButton
              type="submit"
              aria-label={`Quick add ${meal.title ?? "meal"}`}
            >
              <span class="text-sm text-text-main">
                {meal.title ?? "Untitled"}
              </span>
            </PillButton>
          </form>
        ))
      }
    </div>

    {
      recentMeals.length === 0 && (
        <div class="text-center py-4 text-xs text-text-muted italic">
          No recent meals yet.
        </div>
      )
    }
  </div>
</section>

<style>
  .quick-add-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
