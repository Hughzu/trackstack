---
import Skeleton from "@/components/Skeleton.astro";
---

<div class="flex flex-col gap-5 pb-24" data-expenses-dashboard>
  <p
    class="hidden rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-100"
    data-expenses-error
    role="alert"
  >
    Unable to load expenses data right now.
  </p>

  <section>
    <div class="mb-2 flex items-center justify-between px-1">
      <div>
        <div class="text-xs uppercase tracking-widest text-text-muted">Period</div>
        <div class="flex h-5 items-center" data-expenses-period><Skeleton class="h-4 w-16 rounded bg-white/10" /></div>
      </div>
      <button
        type="button"
        class="rounded-full border border-primary/30 px-3 py-1.5 text-[10px] uppercase tracking-widest text-primary transition-colors hover:border-primary/60 hover:bg-primary/10"
        data-expense-close
      >
        Close month
      </button>
    </div>

    <div class="relative flex flex-col overflow-hidden rounded-2xl border border-primary/20 bg-surface p-5 text-text-main shadow-lg shadow-black/40 ring-1 ring-primary/20">
      <div class="mb-4 flex items-start justify-between">
        <div>
          <span class="text-xs uppercase tracking-widest text-text-muted">Remaining</span>
          <div class="flex h-9 items-center" data-expenses-remaining><Skeleton class="h-8 w-24 rounded bg-white/10" /></div>
        </div>
        <div class="text-right">
          <span class="text-xs uppercase tracking-widest text-text-muted">Income</span>
          <div class="flex h-5 items-center justify-end" data-expenses-income><Skeleton class="h-4 w-16 rounded bg-white/10" /></div>
        </div>
      </div>

      <div class="mb-4 flex h-2 overflow-hidden rounded-full bg-gray-800" data-expenses-bar></div>
      <div class="mb-4 flex justify-between text-[10px] font-mono text-text-muted" data-expenses-ratio-labels></div>

      <div class="flex justify-between text-center divide-x divide-white/10" data-expenses-ratio-values></div>
    </div>
  </section>

  <section>
    <details class="group" open>
      <summary class="mb-2 flex cursor-pointer list-none items-center justify-between px-1">
        <div class="flex items-center gap-2">
          <h3 class="text-sm font-bold text-text-muted">Obligations</h3>
          <span class="flex h-5 items-center rounded-full bg-orange-500/20 px-2 group-open:bg-transparent" data-expenses-obligations-count>
            <Skeleton class="h-4 w-8 rounded-full bg-orange-500/30" />
          </span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 text-text-muted transition-transform group-open:rotate-180">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
        </svg>
      </summary>

      <div class="flex flex-col gap-2 animate-fade-in" data-expense-checklist>
        <div class="overflow-hidden rounded-2xl border border-primary/20 bg-panel shadow-lg shadow-black/40 divide-y divide-white/5" data-expenses-obligations-list>
          <div class="flex items-center justify-between p-4">
            <div class="flex gap-3 items-center">
              <Skeleton class="h-5 w-5 rounded-md bg-white/10" />
              <Skeleton class="h-4 w-24 rounded bg-white/10" />
            </div>
            <Skeleton class="h-4 w-12 rounded bg-white/10" />
          </div>
          <div class="flex items-center justify-between p-4">
            <div class="flex gap-3 items-center">
              <Skeleton class="h-5 w-5 rounded-md bg-white/10" />
              <Skeleton class="h-4 w-32 rounded bg-white/10" />
            </div>
            <Skeleton class="h-4 w-16 rounded bg-white/10" />
          </div>
        </div>
      </div>
    </details>
  </section>

  <section>
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2 px-1">
      <h3 class="text-sm font-bold text-text-muted">History</h3>
      <div class="flex items-center gap-2" data-expense-filters>
        <button class="rounded-full border border-white/10 bg-white/10 px-2.5 py-1 text-[10px] uppercase tracking-widest text-text-muted" data-expense-filter="all" type="button">All</button>
        <button class="rounded-full border border-red-500/40 px-2.5 py-1 text-[10px] uppercase tracking-widest text-red-300 opacity-50 hover:bg-red-500/10" data-expense-filter="fund" type="button">Fund.</button>
        <button class="rounded-full border border-orange-500/40 px-2.5 py-1 text-[10px] uppercase tracking-widest text-orange-300 opacity-50 hover:bg-orange-500/10" data-expense-filter="fun" type="button">Fun</button>
        <button class="rounded-full border border-emerald-500/40 px-2.5 py-1 text-[10px] uppercase tracking-widest text-emerald-300 opacity-50 hover:bg-emerald-500/10" data-expense-filter="future" type="button">Future</button>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-primary/20 bg-panel shadow-lg shadow-black/40 divide-y divide-white/5" data-expense-history>
      <div class="flex items-center justify-between p-4">
        <div class="flex flex-col gap-2">
          <Skeleton class="h-4 w-32 rounded bg-white/10" />
          <Skeleton class="h-3 w-16 rounded bg-white/10" />
        </div>
        <Skeleton class="h-4 w-12 rounded bg-white/10" />
      </div>
      <div class="flex items-center justify-between p-4">
        <div class="flex flex-col gap-2">
          <Skeleton class="h-4 w-24 rounded bg-white/10" />
          <Skeleton class="h-3 w-20 rounded bg-white/10" />
        </div>
        <Skeleton class="h-4 w-16 rounded bg-white/10" />
      </div>
    </div>
  </section>
</div>

<script>
  import { resolveBrowserApiUrl } from "@/config/api";

  const euroFormatter = new Intl.NumberFormat("en-IE", {
    style: "currency",
    currency: "EUR",
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  const formatEuro = (value) => euroFormatter.format(Number(value ?? 0));

  const waitForAuthReady = () => {
    if (document.documentElement.dataset.authReady === "true") {
      return Promise.resolve(window.__TRACKSTACK_AUTH__);
    }

    return new Promise((resolve) => {
      const handler = (event) => {
        document.removeEventListener("trackstack:auth-ready", handler);
        resolve(event.detail);
      };
      document.addEventListener("trackstack:auth-ready", handler);
    });
  };

  const renderSegments = (container, segments) => {
    if (!container) return;
    container.innerHTML = "";
    
    // Add mapping function
    const getColorClass = (categoryId) => {
      if (categoryId === 'fun') return 'bg-orange-500';
      if (categoryId === 'future') return 'bg-emerald-500';
      return 'bg-red-500'; // default/fund
    };

    segments.forEach((segment) => {
      const bar = document.createElement("div");
      // Use map to determine color, and add transition classes
      bar.className = `${getColorClass(segment.categoryId)} h-full transition-all duration-1000 ease-out`;
      bar.style.width = `${segment.percent}%`;
      container.appendChild(bar);
    });
  };

  const renderRatioLabels = (container, ratios) => {
    if (!container) return;
    container.innerHTML = "";
    
    const getTextColorClass = (categoryId) => {
      if (categoryId === 'fun') return 'text-orange-400';
      if (categoryId === 'future') return 'text-emerald-400';
      return 'text-red-400';
    };

    ratios.forEach((ratio) => {
      const label = document.createElement("span");
      label.className = ratio.over ? `font-semibold ${getTextColorClass(ratio.categoryId)}` : "text-text-muted";
      label.textContent = `${ratio.label} ${ratio.percent}%`;
      container.appendChild(label);
    });
  };

  const renderRatioValues = (container, ratios) => {
    if (!container) return;
    container.innerHTML = "";

    const getBgColorClass = (categoryId) => {
      if (categoryId === 'fun') return 'bg-orange-500';
      if (categoryId === 'future') return 'bg-emerald-500';
      return 'bg-red-500';
    };

    ratios.forEach((ratio) => {
      const item = document.createElement("div");
      item.className = "flex-1 px-1";
      item.innerHTML = `
        <div class="mx-auto mb-1 h-1.5 w-1.5 rounded-full ${getBgColorClass(ratio.categoryId)}"></div>
        <div class="text-[10px] uppercase text-text-muted">${ratio.label}</div>
        <div class="text-xs font-bold">${formatEuro(ratio.value)}</div>
        <div class="text-[10px] text-text-muted">/ ${formatEuro(ratio.budget)}</div>
      `;
      container.appendChild(item);
    });
  };

  const createChecklistRow = (item) => {
    const row = document.createElement("div");
    row.className = "group flex items-center justify-between p-3";
    row.setAttribute("data-checklist-row", "");
    row.innerHTML = `
      <div class="flex min-w-0 items-center gap-3">
        <form data-api-form action="/api/expenses/checklists/complete" method="POST">
          <input type="hidden" name="id" value="${item.id}" />
          <button type="submit" class="flex h-5 w-5 items-center justify-center rounded-md border border-gray-600 transition-all hover:border-emerald-500 hover:bg-emerald-500/20 group/btn">
            <svg class="h-3.5 w-3.5 text-emerald-500 opacity-0 group-hover/btn:opacity-100" viewBox="0 0 20 20" fill="currentColor">
              <path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" />
            </svg>
          </button>
        </form>
        <span>${item.title}</span>
      </div>
      <div class="text-sm font-mono">EUR ${item.amount}</div>
    `;
    return row;
  };

  const formatCategory = (category) => {
    if (category === "fun") return "Fun";
    if (category === "future") return "Future";
    return "Fund.";
  };

  const categoryClass = (category) => {
    if (category === "fun") return "text-orange-400";
    if (category === "future") return "text-emerald-400";
    return "text-red-400";
  };

  const formatDateLabel = (dateValue) => {
    const date = new Date(`${dateValue}T00:00:00`);
    const today = new Date();
    const startToday = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    const startDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());
    const diffDays = Math.round((startToday.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24));
    if (diffDays === 0) return "Today";
    if (diffDays === 1) return "Yesterday";
    return date.toLocaleDateString("en-GB", { day: "2-digit", month: "short" });
  };

  const createHistoryRow = (tx) => {
    const row = document.createElement("div");
    row.className = "group flex items-center justify-between p-3";
    row.setAttribute("data-expense-item", "");
    row.setAttribute("data-expense-category", tx.category);

    const badge = tx.type === "recurring"
      ? '<span class="rounded border border-white/10 px-1 text-[8px] text-text-muted">AUTO</span>'
      : tx.type === "checklist"
        ? '<span class="rounded border border-white/10 px-1 text-[8px] text-text-muted">CHECK</span>'
        : "";

    row.innerHTML = `
      <div class="min-w-0">
        <div class="flex items-center gap-2 text-sm font-medium">
          ${tx.title}
          ${badge}
        </div>
        <div class="text-[10px] text-text-muted">
          ${formatDateLabel(tx.date)} • <span class="${categoryClass(tx.category)}">${formatCategory(tx.category)}</span>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-sm font-mono text-red-400">-${formatEuro(tx.amount)}</span>
      </div>
    `;

    const deleteButton = document.createElement("button");
    deleteButton.type = "button";
    deleteButton.className = "h-10 w-10 rounded-full text-gray-600 transition-colors hover:text-red-500 active:bg-red-500/10";
    deleteButton.setAttribute("aria-label", "Delete");
    deleteButton.setAttribute("data-expense-delete", "");
    deleteButton.setAttribute("data-expense-id", tx.id);
    deleteButton.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>';
    row.lastElementChild.appendChild(deleteButton);
    return row;
  };

  const renderChecklist = (items) => {
    const count = document.querySelector("[data-expenses-obligations-count]");
    const list = document.querySelector("[data-expenses-obligations-list]");
    if (!count || !list) return;

    count.textContent = `${items.length} Left`;
    list.innerHTML = "";
    if (!items.length) {
      list.innerHTML = '<div class="p-4 text-center text-xs italic text-text-muted">All obligations paid for this month!</div>';
      return;
    }

    items.forEach((item) => list.appendChild(createChecklistRow(item)));
  };

  const renderHistory = (items) => {
    const list = document.querySelector("[data-expense-history]");
    if (!list) return;

    list.innerHTML = "";
    if (!items.length) {
      list.innerHTML = '<div class="p-4 text-center text-xs italic text-text-muted">No expenses yet for this sheet.</div>';
      return;
    }

    items.forEach((item) => list.appendChild(createHistoryRow(item)));
  };

  const bindFilters = () => {
    const filterRoot = document.querySelector("[data-expense-filters]");
    const historyRoot = document.querySelector("[data-expense-history]");
    if (!filterRoot || !historyRoot || filterRoot.dataset.bound === "true") return;
    filterRoot.dataset.bound = "true";

    filterRoot.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest("[data-expense-filter]");
      if (!button) return;

      const value = button.getAttribute("data-expense-filter") || "all";
      filterRoot.querySelectorAll("[data-expense-filter]").forEach((btn) => {
        if (!(btn instanceof HTMLElement)) return;
        const isActive = btn.getAttribute("data-expense-filter") === value;
        btn.classList.toggle("bg-white/10", isActive);
        btn.classList.toggle("opacity-50", !isActive);
      });

      historyRoot.querySelectorAll("[data-expense-item]").forEach((row) => {
        if (!(row instanceof HTMLElement)) return;
        const category = row.getAttribute("data-expense-category");
        row.classList.toggle("hidden", !(value === "all" || category === value));
      });
    });
  };

  const showError = () => {
    const error = document.querySelector("[data-expenses-error]");
    if (error) error.classList.remove("hidden");
  };

  const renderDashboard = (viewModel) => {
    document.querySelector("[data-expenses-period]").textContent = viewModel.periodKey;
    document.querySelector("[data-expenses-remaining]").textContent = formatEuro(viewModel.balance.remaining);
    document.querySelector("[data-expenses-income]").textContent = formatEuro(viewModel.balance.income);
    renderSegments(document.querySelector("[data-expenses-bar]"), viewModel.ratios);
    renderRatioLabels(document.querySelector("[data-expenses-ratio-labels]"), viewModel.ratios);
    renderRatioValues(document.querySelector("[data-expenses-ratio-values]"), viewModel.ratios);
    renderChecklist(viewModel.pendingObligations ?? []);
    renderHistory(viewModel.history ?? []);
    bindFilters();
    document.dispatchEvent(new CustomEvent("trackstack:bind-api-forms"));
  };

  const loadDashboard = async () => {
    const root = document.querySelector("[data-expenses-dashboard]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const auth = await waitForAuthReady();
    if (!auth?.authenticated) return;

    try {
      const token = window.localStorage.getItem("trackstack_token");
      const headers: Record<string, string> = {};
      if (token) headers["Authorization"] = `Bearer ${token}`;

      const response = await fetch(resolveBrowserApiUrl("/api/expenses/sheet/current"), {
        headers,
      });

      if (response.status === 401) {
        window.location.replace("/login");
        return;
      }

      if (!response.ok) {
        showError();
        return;
      }

      const viewModel = await response.json();
      renderDashboard(viewModel);
    } catch {
      showError();
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadDashboard, { once: true });
  } else {
    loadDashboard();
  }

  document.addEventListener("astro:page-load", loadDashboard);
</script>
