---
import FormShell from "@/components/FormShell.astro";
import FormCard from "@/components/FormCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ConfirmModal from "@/components/ConfirmModal.astro";
---

<FormShell
  title="Settings"
  cancelHref="/expenses"
  formId="expenses-settings-form"
  class="pb-20"
  data-api-form
  data-redirect="/expenses"
  data-error-target="expenses-settings-error"
  action="/api/expenses/settings"
  method="POST"
>
  <p id="expenses-settings-error" class="hidden text-xs text-red-200" role="alert">
    Unable to save settings. Check the fields and try again.
  </p>

  <section class="flex flex-col gap-3">
    <SectionHeader title="Projected Income" size="xs" uppercase />
    <FormCard class="flex items-center justify-between">
      <div class="flex flex-col">
        <span class="text-sm font-medium">Monthly Net</span>
        <span class="text-[10px] text-text-muted">Sets the budget denominator</span>
      </div>
      <div class="relative w-32">
        <span class="absolute left-0 top-1/2 -translate-y-1/2 text-text-muted">EUR</span>
        <input
          type="number"
          name="income"
          data-expenses-income-input
          class="w-full bg-transparent text-right font-bold text-xl focus:outline-none border-b border-transparent focus:border-primary transition-colors text-text-main placeholder:text-text-muted/30"
        />
      </div>
    </FormCard>
  </section>

  <section class="flex flex-col gap-4">
    <div class="flex justify-between items-end px-1">
      <SectionHeader title="Ratios" size="xs" uppercase />
      <span class="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full font-mono" data-ratio-total>
        Total: 0%
      </span>
    </div>

    <FormCard class="gap-6">
      <div class="space-y-3">
        <div class="flex justify-between text-sm items-center">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>
            <span class="font-medium">Fundamentals</span>
          </span>
          <span class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border" data-ratio-label="fund">0%</span>
        </div>
        <input type="range" min="0" max="100" name="ratioFund" data-ratio-input="fund" class="w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-red-500 hover:accent-red-400 transition-colors" />
      </div>

      <div class="space-y-3">
        <div class="flex justify-between text-sm items-center">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-orange-500"></span>
            <span class="font-medium">Fun</span>
          </span>
          <span class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border" data-ratio-label="fun">0%</span>
        </div>
        <input type="range" min="0" max="100" name="ratioFun" data-ratio-input="fun" class="w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-orange-500 hover:accent-orange-400 transition-colors" />
      </div>

      <div class="space-y-3">
        <div class="flex justify-between text-sm items-center">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="font-medium">Future</span>
          </span>
          <span class="font-mono bg-background px-2 py-0.5 rounded text-xs border border-border" data-ratio-label="future">0%</span>
        </div>
        <input type="range" min="0" max="100" name="ratioFuture" data-ratio-input="future" class="w-full h-1.5 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-emerald-500 hover:accent-emerald-400 transition-colors" />
      </div>
    </FormCard>
  </section>

  <section class="flex flex-col gap-3">
    <div class="px-1">
      <SectionHeader title="Monthly Checklist" size="xs" uppercase />
      <p class="text-[10px] text-text-muted mt-0.5">Recurring payments to check off every month.</p>
    </div>

    <div class="bg-panel border border-primary/20 rounded-2xl shadow-lg shadow-black/40 divide-y divide-white/5 overflow-hidden" data-checklist-list>
      <div class="p-4 text-center text-text-muted text-xs italic">All obligations paid for this month!</div>
      <div class="p-3 bg-black/20 grid grid-cols-[1.6fr_0.8fr_0.7fr_auto] gap-3 items-center" data-checklist-composer>
        <input form="expense-checklist-form" name="title" type="text" placeholder="Name (e.g. Netflix)" class="min-w-0 bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 transition-colors text-text-main" required />
        <input form="expense-checklist-form" name="amount" type="number" step="0.01" placeholder="EUR" class="min-w-0 bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 text-right transition-colors text-text-main" required />
        <select form="expense-checklist-form" name="category" class="min-w-0 bg-surface border border-border rounded-lg px-2 py-1 text-xs text-text-main appearance-none focus:outline-none focus:border-primary" required>
          <option value="fund">Fund.</option>
          <option value="fun">Fun</option>
          <option value="future">Future</option>
        </select>
        <button form="expense-checklist-form" type="submit" class="text-primary hover:text-primary/80 font-bold text-xs bg-primary/10 px-3 py-1.5 rounded-full border border-primary/20 transition-all">Add</button>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-3">
    <div class="px-1">
      <SectionHeader title="Recurring Expenses" size="xs" uppercase />
      <p class="text-[10px] text-text-muted mt-0.5">Auto-added to every new sheet.</p>
    </div>

    <div class="bg-panel border border-primary/20 rounded-2xl shadow-lg shadow-black/40 divide-y divide-white/5 overflow-hidden" data-recurring-list>
      <div class="p-4 text-center text-text-muted text-xs italic">No recurring expenses yet.</div>
      <div class="p-3 bg-black/20 grid grid-cols-[1.6fr_0.8fr_0.7fr_auto] gap-3 items-center" data-recurring-composer>
        <input form="expense-recurring-form" name="title" type="text" placeholder="Name (e.g. Rent)" class="min-w-0 bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 transition-colors text-text-main" required />
        <input form="expense-recurring-form" name="amount" type="number" step="0.01" placeholder="EUR" class="min-w-0 bg-transparent border-b border-white/10 text-sm focus:border-primary focus:outline-none py-1 placeholder:text-text-muted/30 text-right transition-colors text-text-main" required />
        <select form="expense-recurring-form" name="category" class="min-w-0 bg-surface border border-border rounded-lg px-2 py-1 text-xs text-text-main appearance-none focus:outline-none focus:border-primary" required>
          <option value="fund">Fund.</option>
          <option value="fun">Fun</option>
          <option value="future">Future</option>
        </select>
        <button form="expense-recurring-form" type="submit" class="text-primary hover:text-primary/80 font-bold text-xs bg-primary/10 px-3 py-1.5 rounded-full border border-primary/20 transition-all">Add</button>
      </div>
    </div>
  </section>
</FormShell>

<form id="expense-checklist-form" data-api-form action="/api/expenses/checklists" method="POST"></form>
<form id="expense-recurring-form" data-api-form action="/api/expenses/recurring" method="POST"></form>

<ConfirmModal
  id="expense-checklist-delete-modal"
  title="Delete checklist item?"
  description="This removes the item from your monthly checklist."
  confirmLabel="Delete"
  confirmLoadingLabel="Deleting..."
  triggerAttribute="data-checklist-delete"
  idAttribute="data-checklist-id"
  endpoint="/api/expenses/checklists/{id}"
  sendPayload={false}
  method="DELETE"
  errorMessage="Unable to delete checklist item."
/>

<ConfirmModal
  id="expense-recurring-delete-modal"
  title="Delete recurring expense?"
  description="This removes the item from future sheets."
  confirmLabel="Delete"
  confirmLoadingLabel="Deleting..."
  triggerAttribute="data-recurring-delete"
  idAttribute="data-recurring-id"
  endpoint="/api/expenses/recurring/{id}"
  sendPayload={false}
  method="DELETE"
  errorMessage="Unable to delete recurring expense."
/>

<script>
  import { resolveBrowserApiUrl } from "@/config/api";

  const waitForAuthReady = () => {
    if (document.documentElement.dataset.authReady === "true") {
      return Promise.resolve(window.__TRACKSTACK_AUTH__);
    }

    return new Promise((resolve) => {
      const handler = (event) => {
        document.removeEventListener("trackstack:auth-ready", handler);
        resolve(event.detail);
      };
      document.addEventListener("trackstack:auth-ready", handler);
    });
  };

  const settingsForm = () => document.getElementById("expenses-settings-form");
  const ratioTotalEl = () => document.querySelector("[data-ratio-total]");
  const ratioLabel = (key) => document.querySelector(`[data-ratio-label="${key}"]`);
  const ratioInput = (key) => document.querySelector(`[data-ratio-input="${key}"]`);
  const incomeInput = () => document.querySelector("[data-expenses-income-input]");

  const updateRatios = () => {
    const fundValue = Number(ratioInput("fund")?.value || 0);
    const funValue = Number(ratioInput("fun")?.value || 0);
    const futureValue = Number(ratioInput("future")?.value || 0);
    const total = fundValue + funValue + futureValue;

    if (ratioTotalEl()) ratioTotalEl().textContent = `Total: ${total}%`;
    if (ratioLabel("fund")) ratioLabel("fund").textContent = `${fundValue}%`;
    if (ratioLabel("fun")) ratioLabel("fun").textContent = `${funValue}%`;
    if (ratioLabel("future")) ratioLabel("future").textContent = `${futureValue}%`;
  };

  const bindRatioUpdates = () => {
    const form = settingsForm();
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    [ratioInput("fund"), ratioInput("fun"), ratioInput("future")].forEach((input) => {
      input?.addEventListener("input", updateRatios);
      input?.addEventListener("change", updateRatios);
    });
  };

  const formatCategory = (category) => {
    if (category === "fun") return "Fun";
    if (category === "future") return "Future";
    return "Fund.";
  };

  const createDeleteButton = (kind, id, label) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "w-10 h-10 flex items-center justify-center rounded-full transition-colors text-gray-600 hover:text-red-500 active:bg-red-500/10";
    button.setAttribute("aria-label", label);
    button.setAttribute(kind === "checklist" ? "data-checklist-delete" : "data-recurring-delete", "");
    button.setAttribute(kind === "checklist" ? "data-checklist-id" : "data-recurring-id", id);
    button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>';
    return button;
  };

  const createTemplateRow = (item, kind) => {
    const row = document.createElement("div");
    row.className = "p-3 flex justify-between items-center group";

    const left = document.createElement("div");
    left.className = "min-w-0 font-medium text-sm";
    left.textContent = item.title;

    const right = document.createElement("div");
    right.className = "flex items-center gap-3";

    const category = document.createElement("span");
    category.className = "text-[10px] uppercase text-text-muted";
    category.textContent = formatCategory(item.category);

    const amount = document.createElement("span");
    amount.className = "font-mono text-sm text-text-muted";
    amount.textContent = `EUR ${item.amount}`;

    right.append(category, amount, createDeleteButton(kind, item.id, kind === "checklist" ? "Delete checklist item" : "Delete recurring expense"));
    row.append(left, right);
    return row;
  };

  const renderTemplateList = (selector, composerSelector, items, emptyMessage, kind) => {
    const root = document.querySelector(selector);
    const composer = document.querySelector(composerSelector);
    if (!root || !composer) return;

    root.innerHTML = "";
    if (!items.length) {
      const empty = document.createElement("div");
      empty.className = "p-4 text-center text-text-muted text-xs italic";
      empty.textContent = emptyMessage;
      root.appendChild(empty);
    } else {
      items.forEach((item) => root.appendChild(createTemplateRow(item, kind)));
    }
    root.appendChild(composer);
  };

  const loadSettings = async () => {
    const auth = await waitForAuthReady();
    if (!auth?.authenticated) return;

    try {
      const token = window.localStorage.getItem("trackstack_token");
      const headers: Record<string, string> = {};
      if (token) headers["X-Trackstack-Authorization"] = `Bearer ${token}`;

      const response = await fetch(resolveBrowserApiUrl("/api/expenses/settings"), {
        headers,
      });

      if (response.status === 401) {
        window.location.replace("/login");
        return;
      }

      if (!response.ok) return;

      const payload = await response.json();
      if (incomeInput()) incomeInput().value = String(payload.settings?.income ?? "");
      if (ratioInput("fund")) ratioInput("fund").value = String(payload.settings?.ratioFund ?? 0);
      if (ratioInput("fun")) ratioInput("fun").value = String(payload.settings?.ratioFun ?? 0);
      if (ratioInput("future")) ratioInput("future").value = String(payload.settings?.ratioFuture ?? 0);
      updateRatios();

      renderTemplateList("[data-checklist-list]", "[data-checklist-composer]", payload.checklist ?? [], "All obligations paid for this month!", "checklist");
      renderTemplateList("[data-recurring-list]", "[data-recurring-composer]", payload.recurring ?? [], "No recurring expenses yet.", "recurring");
    } catch {
      // Leave static defaults in place.
    }
  };

  const init = () => {
    bindRatioUpdates();
    updateRatios();
    loadSettings();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }

  document.addEventListener("astro:page-load", init);
</script>
