---
import Card from "@/components/Card.astro";
import PercentageBar from "@/components/PercentageBar.astro";

interface Ratio {
  percent: number;
  color: string;
  label: string;
  value: number;
  budget: number;
  target: number;
  over: boolean;
}

interface Props {
  periodKey: string;
  balance: {
    remaining: number;
    income: number;
  };
  ratios: Ratio[];
}

const { periodKey, balance } = Astro.props;
const ratios = Astro.props.ratios ?? [];
---

<section>
  <div class="flex items-center justify-between px-1 mb-2">
    <div>
      <div class="text-xs text-text-muted uppercase tracking-widest">
        Period
      </div>
      <div class="text-sm font-semibold text-text-main">{periodKey}</div>
    </div>
    <button
      type="button"
      class="px-3 py-1.5 rounded-full border border-primary/30 text-[10px] uppercase tracking-widest text-primary hover:border-primary/60 hover:bg-primary/10 transition-colors"
      data-expense-close
    >
      Close month
    </button>
  </div>
  <Card variant="highlight">
    <div class="flex justify-between items-start mb-4">
      <div>
        <span class="text-xs text-text-muted uppercase tracking-widest"
          >Remaining</span
        >
        <div class="text-3xl font-bold text-text-main">
          €{balance.remaining}
        </div>
      </div>
      <div class="text-right">
        <span class="text-xs text-text-muted uppercase tracking-widest"
          >Income</span
        >
        <div class="text-sm font-mono text-text-muted">€{balance.income}</div>
      </div>
    </div>

    <div class="mb-4">
      <PercentageBar segments={ratios} />
    </div>

    <div class="flex justify-between text-center divide-x divide-white/10">
      {
        ratios.map((r) => (
          <div class="flex-1 px-1">
            <div class={`w-1.5 h-1.5 rounded-full ${r.color} mx-auto mb-1`} />
            <div class="text-[10px] text-text-muted uppercase">{r.label}</div>
            <div class="text-xs font-bold">€{r.value}</div>
            <div class="text-[10px] text-text-muted">/ €{r.budget}</div>
          </div>
        ))
      }
    </div>
  </Card>
</section>
