---
import Head from "@/layouts/Head.astro";
import ClientRuntime from "@/layouts/ClientRuntime.astro";
import ApiFormHandler from "@/layouts/ApiFormHandler.astro";
import AuthBootstrap from "@/layouts/AuthBootstrap.astro";

interface Props {
  title?: string;
  authMode?: "none" | "required" | "public-only";
}

const { title = "App", authMode = "none" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} viewport="width=device-width" />
  </head>
  <body>
    <slot />
    <ClientRuntime />
    <ApiFormHandler />
    <AuthBootstrap authMode={authMode} />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
