---
import { apiConfig } from "@/config/api";

interface Props {
  authMode?: "none" | "required" | "public-only";
}

const { authMode = "none" } = Astro.props;
---

<script define:vars={{ authMode, directBrowserCalls: apiConfig.directBrowserCalls, publicApiBaseUrl: apiConfig.publicBaseUrl }}>
  const bootstrapAuthMode = authMode;
  const browserDirectApiCalls = directBrowserCalls;
  const apiBaseUrl = publicApiBaseUrl;
  const authBootstrapState = window.__TRACKSTACK_AUTH_BOOTSTRAP__ ?? {
    key: "",
    promise: null,
    listenerInstalled: false,
    run: null,
  };

  window.__TRACKSTACK_AUTH_BOOTSTRAP__ = authBootstrapState;

  const resolveSessionUrl = () => {
    const path = "/api/auth/session";
    if (!browserDirectApiCalls) {
      return path;
    }

    const base = apiBaseUrl.replace(/\/+$/, "").replace(/\/api$/, "");
    return `${base}${path}`;
  };

  const publishAuthState = (state) => {
    window.__TRACKSTACK_AUTH__ = state;
    document.documentElement.dataset.authReady = "true";
    document.documentElement.dataset.authenticated = state.authenticated ? "true" : "false";
    document.dispatchEvent(new CustomEvent("trackstack:auth-ready", { detail: state }));
  };

  const handleUnauthenticated = () => {
    const state = { authenticated: false };
    publishAuthState(state);

    if (bootstrapAuthMode === "required" && window.location.pathname !== "/login") {
      window.location.replace("/login");
    }
  };

  authBootstrapState.run = async () => {
    if (bootstrapAuthMode === "none") return;

    const navigationKey = `${bootstrapAuthMode}:${window.location.pathname}${window.location.search}`;
    if (authBootstrapState.key === navigationKey && authBootstrapState.promise) {
      return authBootstrapState.promise;
    }

    authBootstrapState.key = navigationKey;
    authBootstrapState.promise = (async () => {
      try {
        const token = window.localStorage.getItem("trackstack_token");
        if (!token) {
          handleUnauthenticated();
          return;
        }

        const response = await fetch(resolveSessionUrl(), {
          headers: {
            "Authorization": `Bearer ${token}`,
          },
        });

        if (!response.ok) {
          handleUnauthenticated();
          return;
        }

        const payload = await response.json();
        const state = {
          authenticated: true,
          userId: payload.userId,
          sessionId: payload.sessionId,
        };

        publishAuthState(state);

        if (bootstrapAuthMode === "public-only") {
          window.location.replace("/");
        }
      } catch {
        handleUnauthenticated();
      }
    })();

    return authBootstrapState.promise;
  };

  if (!authBootstrapState.listenerInstalled) {
    document.addEventListener("astro:page-load", () => {
      const currentBootstrap = window.__TRACKSTACK_AUTH_BOOTSTRAP__;
      if (currentBootstrap?.run) {
        void currentBootstrap.run();
      }
    });
    authBootstrapState.listenerInstalled = true;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      const currentBootstrap = window.__TRACKSTACK_AUTH_BOOTSTRAP__;
      if (currentBootstrap?.run) {
        void currentBootstrap.run();
      }
    }, { once: true });
  } else {
    void authBootstrapState.run();
  }
</script>
