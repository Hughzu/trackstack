---
import { ClientRouter } from "astro:transitions";
import DomainNav from "@/components/DomainNav.astro";
import TopBar from "@/components/TopBar.astro";
import Head from "@/layouts/Head.astro";
import ClientRuntime from "@/layouts/ClientRuntime.astro";
import ApiFormHandler from "@/layouts/ApiFormHandler.astro";
import AuthBootstrap from "@/layouts/AuthBootstrap.astro";
import { appConfig, type AppDomain, type AppProfile } from "@/config/app";
import "@/styles/global.css";

interface Props {
  title?: string;
  currentDomain?: string;
  domains?: AppDomain[];
  appName?: string;
  profile?: AppProfile;
}

const {
  title,
  currentDomain,
  domains = appConfig.domains,
  appName = appConfig.appName,
  profile = appConfig.profile
} = Astro.props;
const navDomains = domains ?? [];
const resolvedTitle = title ?? appName ?? "";
const resolvedDomain = currentDomain ?? navDomains[0]?.id ?? "home";
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={resolvedTitle} />
    <ClientRouter />
  </head>
  <body
    class="bg-background text-text-main antialiased selection:bg-primary/30"
  >
    <header
      class="sticky top-0 z-50 bg-background/95 backdrop-blur-md
transition-all duration-300 border-b border-transparent transition-border"
    >
      <TopBar appName={appName} profile={profile} />
      <DomainNav current={resolvedDomain} domains={navDomains} />
    </header>
    <main class="max-w-3xl mx-auto px-4 pt-6 animate-fade-in min-h-[60vh]">
      <slot />
    </main>
    <div
      class="fixed inset-x-0 bottom-0 z-50 flex justify-center pointer-events-none px-4"
      style="padding-bottom: calc(3.5rem + env(safe-area-inset-bottom));"
    >
      <div
        class="pointer-events-auto flex gap-3 shadow-xl
rounded-full p-1 bg-surface/5 backdrop-blur-sm"
      >
        <slot name="actions" />
      </div>
    </div>

    <ClientRuntime />
    <ApiFormHandler />
    <AuthBootstrap authMode="required" />
  </body>
</html>
