---
import { apiConfig } from "@/config/api";
---

<script define:vars={{ directBrowserCalls: apiConfig.directBrowserCalls, publicApiBaseUrl: apiConfig.publicBaseUrl }}>
  const browserDirectApiCalls = directBrowserCalls;
  const apiBaseUrl = publicApiBaseUrl;

  const shouldUseDirectBrowserApi = (input) => {
    if (!input || typeof input !== "string") return false;
    if (input.startsWith("http://") || input.startsWith("https://")) {
      return false;
    }

    const normalizedPath = input.startsWith("/api")
      ? input
      : `/api${input.startsWith("/") ? input : `/${input}`}`;

    return !normalizedPath.startsWith("/api/auth/");
  };

  const resolveApiUrl = (input) => {
    if (!input || typeof input !== "string") return input;
    if (input.startsWith("http://") || input.startsWith("https://")) {
      return input;
    }

    const normalizedPath = input.startsWith("/api")
      ? input
      : `/api${input.startsWith("/") ? input : `/${input}`}`;

    if (!browserDirectApiCalls || !shouldUseDirectBrowserApi(normalizedPath)) {
      return normalizedPath;
    }

    const base = apiBaseUrl.replace(/\/+$/, "").replace(/\/api$/, "");
    return `${base}${normalizedPath}`;
  };

  const resolveFormAction = (action) => resolveApiUrl(action);

  const ensureSignedFetch = () => {
    if (window.signedFetch) return;

    window.signedFetch = async (input, init = {}) => {
      const method = (init.method || "GET").toUpperCase();
      const requestInput = resolveApiUrl(input);
      const requestInit = { credentials: "include", ...init };
      if (method === "GET" || method === "HEAD") {
        return fetch(requestInput, requestInit);
      }

      const headers = new Headers(requestInit.headers || {});
      let body = requestInit.body;
      let bodyString = "";

      if (typeof body === "string") {
        bodyString = body;
      } else if (body instanceof URLSearchParams) {
        bodyString = body.toString();
        if (!headers.has("Content-Type")) {
          headers.set("Content-Type", "application/x-www-form-urlencoded");
        }
        body = bodyString;
      } else if (body instanceof FormData) {
        bodyString = new URLSearchParams(body).toString();
        if (!headers.has("Content-Type")) {
          headers.set("Content-Type", "application/x-www-form-urlencoded");
        }
        body = bodyString;
      } else if (body && typeof body === "object") {
        bodyString = JSON.stringify(body);
        if (!headers.has("Content-Type")) {
          headers.set("Content-Type", "application/json");
        }
        body = bodyString;
      }

      if (window.crypto?.subtle) {
        const digest = await window.crypto.subtle.digest(
          "SHA-256",
          new TextEncoder().encode(bodyString),
        );
        const hash = Array.from(new Uint8Array(digest))
          .map((b) => b.toString(16).padStart(2, "0"))
          .join("");
        headers.set("x-amz-content-sha256", hash);
      }

      return fetch(requestInput, { ...requestInit, headers, body });
    };
  };

  const bindApiForms = () => {
    const forms = Array.from(document.querySelectorAll("form[data-api-form]"));

    forms.forEach((form) => {
      if (form.dataset.apiFormBound === "true") return;
      form.dataset.apiFormBound = "true";

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const payload = {};
        for (const [key, rawValue] of formData.entries()) {
          if (typeof rawValue !== "string") {
            payload[key] = rawValue;
            continue;
          }

          const namedField = form.elements.namedItem(key);
          const field =
            namedField instanceof RadioNodeList
              ? namedField[0]
              : namedField;
          const isNumberField =
            field instanceof HTMLInputElement &&
            (field.type === "number" || field.type === "range");
          if (isNumberField && rawValue.trim() !== "") {
            const numericValue = Number(rawValue);
            payload[key] = Number.isFinite(numericValue) ? numericValue : rawValue;
            continue;
          }

          payload[key] = rawValue;
        }

        const action = form.getAttribute("action");
        const method = form.getAttribute("method")?.toUpperCase() || "POST";
        const redirectUrl = form.dataset.redirect;

        try {
          const fetcher = window.signedFetch || window.fetch;
          const response = await fetcher(resolveFormAction(action), {
            method: method,
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
            credentials: "include",
          });

          if (response.ok) {
            if (action === "/api/auth/logout") {
              window.location.href = redirectUrl || "/login";
              return;
            }

            if (action === "/api/auth/login") {
              window.location.href = redirectUrl || "/";
              return;
            }

            if (redirectUrl) window.location.href = redirectUrl;
            else window.location.reload();
            return;
          }

          const errorTargetId = form.dataset.errorTarget;
          if (errorTargetId) {
            const errEl = document.getElementById(errorTargetId);
            if (errEl) {
              let msg = "Request failed.";
              try {
                if (action === "/api/auth/login" && response.status === 401) {
                  msg = "Invalid email or password.";
                } else {
                  const data = await response.json();
                  if (data?.error) msg = data.error;
                }
              } catch {}
              errEl.textContent = msg;
              errEl.classList.remove("hidden");
              return;
            }
          }
        } catch (error) {
          console.error("SigV4 Signing or Network error:", error);
        }

        const errorTargetId = form.dataset.errorTarget;
        if (errorTargetId) {
          const errEl = document.getElementById(errorTargetId);
          if (errEl) {
            errEl.textContent = "Network error occurred.";
            errEl.classList.remove("hidden");
            return;
          }
        }

        window.alert("Failed to process request.");
      });
    });
  };

  const init = () => {
    ensureSignedFetch();
    bindApiForms();
  };

  window.__TRACKSTACK_DIRECT_BROWSER_API__ = browserDirectApiCalls;

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:after-swap", init);
</script>
