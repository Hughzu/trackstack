---
interface Props {
  appName: string;
  title?: string;
  subtitle?: string;
  class?: string;
}

const { appName, title, subtitle, class: className } = Astro.props;

const initials = appName
  .split(" ")
  .filter(Boolean)
  .map((part) => part[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<section
  class:list={[
    "min-h-screen bg-[linear-gradient(180deg,rgba(26,29,35,0.85),#0f1115)] text-text-main flex items-center justify-center relative overflow-hidden",
    className
  ]}
>
  <div
    class="absolute h-[28rem] w-[28rem] rounded-full blur-[120px] opacity-60 top-[-12rem] right-[-10rem] bg-[rgba(255,194,91,0.35)]"
    aria-hidden="true"
  ></div>
  <div
    class="absolute h-[28rem] w-[28rem] rounded-full blur-[120px] opacity-60 bottom-[-14rem] left-[-8rem] bg-[rgba(45,49,57,0.7)]"
    aria-hidden="true"
  ></div>

  <div class="w-full max-w-[480px] px-6 pb-[4.5rem] pt-14 flex flex-col gap-10 relative z-10 sm:pt-12 sm:pb-16 sm:gap-8">
    <div class="inline-flex items-center gap-3">
      <div class="h-11 w-11 rounded-2xl bg-primary text-background font-bold inline-flex items-center justify-center tracking-[0.08em]">
        {initials}
      </div>
      <span class="text-[0.95rem] uppercase tracking-[0.3em] text-text-muted">
        {appName}
      </span>
    </div>

    {(title || subtitle) && (
      <div class="flex flex-col gap-2">
        {title && <h1 class="text-4xl font-bold m-0">{title}</h1>}
        {subtitle && <p class="text-[0.95rem] text-text-muted m-0">{subtitle}</p>}
      </div>
    )}

    <div class="bg-surface border border-border rounded-[1.75rem] p-7 shadow-[0_30px_60px_rgba(0,0,0,0.35)] sm:p-6">
      <slot />
    </div>

    <div class="text-xs text-text-muted text-center">
      <slot name="footer" />
    </div>
  </div>
</section>
