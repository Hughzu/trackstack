---
interface Props {
  /**
   * Tailwind classes to apply to the skeleton block. 
   * Example: 'h-8 w-24 rounded-md'
   */
  class?: string;
  /**
   * Optional custom background color for the skeleton. Defaults to a subtle white tint.
   */
  baseColor?: string;
}

const { 
  class: className = 'h-6 w-full rounded-md',
  baseColor = 'bg-white/10'
} = Astro.props;
---

<div class:list={[
  "animate-pulse",
  baseColor,
  className
]}></div>
