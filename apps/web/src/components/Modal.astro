---
interface Props {
    id: string;
    title?: string;
    class?: string;
    [key: string]: any;
}

const { id, title, class: className, ...rest } = Astro.props;
---

<dialog
    id={id}
    data-modal-root="true"
    class:list={[
        "backdrop:bg-black/60 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto open:animate-fade-in focus:outline-none",
        "max-w-[100vw] max-h-[100vh] backdrop:animate-[fade-in_0.2s_ease-out]",
        className,
    ]}
    {...rest}
>
    <div
        class="w-full max-w-sm rounded-2xl border border-border bg-surface p-5 shadow-2xl shadow-black/50 mx-auto"
    >
        {
            title && (
                <h3 class="text-lg font-bold text-text-main mb-2">{title}</h3>
            )
        }
        <slot />
    </div>
</dialog>
