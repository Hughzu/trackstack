---
interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={["p-3 flex justify-between items-center group", className]} {...rest}>
  <div class="min-w-0">
    <slot name="left" />
  </div>
  <div class="flex items-center gap-3">
    <slot name="right" />
  </div>
</div>
